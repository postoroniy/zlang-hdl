// SPDX-License-Identifier: BSD-3-Clause

module ZtpuLayoutDmaControl64x32 {
    clock clk reset rst
    in enable : bit
    in layout_valid : bit
    in layout_in_addr, layout_out_addr : u64
    out layout_ready : bit
    out busy, done, error : bit

    out read_ar_valid : bit
    out read_ar_addr : u64
    out read_ar_len : u8
    out read_ar_size : u3
    in read_ar_ready : bit
    in read_r_valid : bit
    in read_r_data : u32
    in read_r_last : bit
    in read_r_resp : bits<2>
    out read_r_ready : bit

    out write_aw_valid : bit
    out write_aw_addr : u64
    out write_aw_len : u8
    out write_aw_size : u3
    in write_aw_ready : bit
    out write_w_valid : bit
    out write_w_data : u32
    out write_w_last : bit
    in write_w_ready : bit
    in write_b_valid : bit
    in write_b_resp : bits<2>
    out write_b_ready : bit

    reg state : u4 = 0
    reg input_address : u64 = 0
    reg output_address : u64 = 0
    reg read_address : u64 = 0
    reg write_address : u64 = 0
    reg buffered_data : u32 = 0
    reg reader_error : bit = 0
    reg writer_error : bit = 0
    reg failed : bit = 0

    read_unaligned : bit = input_address[1:0] != 0
    write_unaligned : bit = output_address[1:0] != 0
    layout_accept : bit = mux(enable, state == 0, 1)
    layout_transfer : bit = layout_valid & layout_accept
    read_ar_transfer : bit = (state == 3) & read_ar_ready
    read_r_transfer : bit = (state == 4) & read_r_valid
    write_aw_transfer : bit = (state == 7) & write_aw_ready
    write_w_transfer : bit = (state == 8) & write_w_ready
    write_b_transfer : bit = (state == 9) & write_b_valid
    read_failed : bit = read_r_transfer &
        ((read_r_resp != 0) | (read_r_last == 0))
    write_failed : bit = write_b_transfer & (write_b_resp != 0)

    next_state : u4 = switch state {
        0 => mux(layout_transfer, 1, 0)
        1 => mux(read_unaligned, 2, 3)
        2 => 11
        3 => mux(read_ar_transfer, 4, 3)
        4 => mux(read_failed, 11, mux(read_r_transfer, 5, 4))
        5 => mux(write_unaligned, 6, 7)
        6 => 11
        7 => mux(write_aw_transfer, 8, 7)
        8 => mux(write_w_transfer, 9, 8)
        9 => mux(write_b_transfer, 10, 9)
        10 => 11
        11 => 0
        else => 0
    }

    state <- next_state
    layout_ready = layout_accept
    busy = enable & (state != 0)
    done = state == 11
    error = failed

    read_ar_valid = state == 3
    read_ar_addr = read_address
    read_ar_len = 0
    read_ar_size = 2
    read_r_ready = state == 4

    write_aw_valid = state == 7
    write_aw_addr = write_address
    write_aw_len = 0
    write_aw_size = 2
    write_w_valid = state == 8
    write_w_data = buffered_data
    write_w_last = state == 8
    write_b_ready = state == 9

    when layout_transfer {
        input_address <- layout_in_addr
        output_address <- layout_out_addr
    }
    when (state == 1) & !read_unaligned {
        read_address <- input_address
    }
    when (state == 5) & !write_unaligned {
        write_address <- output_address
    }
    when read_r_transfer & !read_failed {
        buffered_data <- read_r_data
    }
    priority {
        when (state == 1) & !read_unaligned { reader_error <- 0 }
        when (state == 1) & read_unaligned { reader_error <- 1 }
        when read_failed { reader_error <- 1 }
    }
    priority {
        when (state == 5) & !write_unaligned { writer_error <- 0 }
        when (state == 5) & write_unaligned { writer_error <- 1 }
        when write_failed { writer_error <- 1 }
    }
    priority {
        when layout_transfer { failed <- 0 }
        when reader_error | writer_error { failed <- 1 }
    }
}
