// SPDX-License-Identifier: BSD-3-Clause

enum ZtpuLayoutDmaPhase {
    Idle
    ReadStart
    ReadReject
    ReadAddress
    ReadData
    WriteStart
    WriteReject
    WriteAddress
    WriteData
    WriteResponse
    WriteComplete
    Done
}

module ZtpuLayoutDmaControl64x32 {
    clock clk reset rst
    in enable : bit
    in layout_valid : bit
    in layout_in_addr, layout_out_addr : u64
    out layout_ready : bit
    out busy, done, error : bit

    out read_ar_valid : bit
    out read_ar_addr : u64
    out read_ar_len : u8
    out read_ar_size : u3
    in read_ar_ready : bit
    in read_r_valid : bit
    in read_r_data : u32
    in read_r_last : bit
    in read_r_resp : bits<2>
    out read_r_ready : bit

    out write_aw_valid : bit
    out write_aw_addr : u64
    out write_aw_len : u8
    out write_aw_size : u3
    in write_aw_ready : bit
    out write_w_valid : bit
    out write_w_data : u32
    out write_w_last : bit
    in write_w_ready : bit
    in write_b_valid : bit
    in write_b_resp : bits<2>
    out write_b_ready : bit

    reg input_address : u64 = 0
    reg output_address : u64 = 0
    reg buffered_data : u32 = 0
    reg failed : bit = 0

    read_unaligned : bit = input_address[1:0] != 0
    write_unaligned : bit = output_address[1:0] != 0
    layout_accept : bit = mux(enable, phase == ZtpuLayoutDmaPhase.Idle, 1)
    layout_transfer : bit = layout_valid & layout_accept
    read_ar_transfer : bit =
        (phase == ZtpuLayoutDmaPhase.ReadAddress) & read_ar_ready
    read_r_transfer : bit =
        (phase == ZtpuLayoutDmaPhase.ReadData) & read_r_valid
    write_aw_transfer : bit =
        (phase == ZtpuLayoutDmaPhase.WriteAddress) & write_aw_ready
    write_w_transfer : bit =
        (phase == ZtpuLayoutDmaPhase.WriteData) & write_w_ready
    write_b_transfer : bit =
        (phase == ZtpuLayoutDmaPhase.WriteResponse) & write_b_valid
    read_failed : bit = read_r_transfer &
        ((read_r_resp != 0) | (read_r_last == 0))
    write_failed : bit = write_b_transfer & (write_b_resp != 0)

    layout_ready = layout_accept
    busy = enable & (phase != ZtpuLayoutDmaPhase.Idle)
    done = phase == ZtpuLayoutDmaPhase.Done
    error = failed

    read_ar_valid = phase == ZtpuLayoutDmaPhase.ReadAddress
    read_ar_addr = input_address
    read_ar_len = 0
    read_ar_size = 2
    read_r_ready = phase == ZtpuLayoutDmaPhase.ReadData

    write_aw_valid = phase == ZtpuLayoutDmaPhase.WriteAddress
    write_aw_addr = output_address
    write_aw_len = 0
    write_aw_size = 2
    write_w_valid = phase == ZtpuLayoutDmaPhase.WriteData
    write_w_data = buffered_data
    write_w_last = 1
    write_b_ready = phase == ZtpuLayoutDmaPhase.WriteResponse

    when layout_transfer {
        input_address <- layout_in_addr
        output_address <- layout_out_addr
    }
    when read_r_transfer & !read_failed {
        buffered_data <- read_r_data
    }
    priority {
        when layout_transfer { failed <- 0 }
        when (phase == ZtpuLayoutDmaPhase.ReadStart) & read_unaligned {
            failed <- 1
        }
        when read_failed { failed <- 1 }
        when (phase == ZtpuLayoutDmaPhase.WriteStart) & write_unaligned {
            failed <- 1
        }
        when write_failed { failed <- 1 }
    }

    fsm phase : ZtpuLayoutDmaPhase = Idle {
        Idle { when layout_transfer -> ReadStart {} }
        ReadStart {
            priority {
                when read_unaligned -> ReadReject {}
                when !read_unaligned -> ReadAddress {}
            }
        }
        ReadReject { -> Done {} }
        ReadAddress { when read_ar_transfer -> ReadData {} }
        ReadData {
            priority {
                when read_failed -> Done {}
                when read_r_transfer -> WriteStart {}
            }
        }
        WriteStart {
            priority {
                when write_unaligned -> WriteReject {}
                when !write_unaligned -> WriteAddress {}
            }
        }
        WriteReject { -> Done {} }
        WriteAddress { when write_aw_transfer -> WriteData {} }
        WriteData { when write_w_transfer -> WriteResponse {} }
        WriteResponse { when write_b_transfer -> WriteComplete {} }
        WriteComplete { -> Done {} }
        Done { -> Idle {} }
    }
}
