import std.dsp.nco_linear

// Paired endpoint ROM plus fractional interpolation: two edges, II=1.
module LinearNco {
    clock clk reset rst
    in input : rv<u16>
    out output : rv<SinCos<fixed<16,14>>>
    oscillator : RvNcoSinCosLinear<PW=16,AW=8,OW=16,OF=14>
    input -> oscillator.input
    oscillator.output -> output
}
