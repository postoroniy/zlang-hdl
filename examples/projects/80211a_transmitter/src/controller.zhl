// IEEE-authoritative packet framing and scrambling for the bounded
// 6/12/24 Mbit/s profile.
//
// This is ordinary ZLang source.  The input carries one to three valid PSDU
// bytes in the low bytes of data.  Output bit zero is the earliest DATA bit:
// sixteen zero SERVICE bits, PSDU bytes (each byte LSB first), six encoder-tail
// zeros, then zero PAD to the selected N_DBPS boundary.  tail_mask identifies
// the six bits that a following scrambler must force back to zero.

import wifi80211a_transmitter.data_types

fn ieee_signal_rate_code(rate : WifiRate) -> bits<4> {
    switch rate {
        WifiRate.Continue => 0
        WifiRate.Bpsk6 => 0b1101
        WifiRate.Qpsk12 => 0b0101
        WifiRate.Qam16_24 => 0b1001
    }
}

fn ieee_signal_header(rate : WifiRate, length : u12) -> bits<24> {
    // IEEE numbers the transmitted SIGNAL bits from zero.  ZLang's raw
    // integer/bit-vector boundary maps representation bit zero to the LSB, so
    // RATE occupies [3:0], reserved is bit 4, LENGTH occupies [16:5], parity
    // is bit 17, and the six tail bits occupy [23:18].
    rate_code = ieee_signal_rate_code(rate)
    signal_data = concat(length, 0, rate_code)
    concat(zeros<6>, parity(signal_data), signal_data)
}

enum IeeeFramerPhase {
    Idle
    Active
}

module IeeeSignalHeader24 {
    in raw_rate : bits<3>
    in length : u12
    out valid : bit
    out header : bits<24>

    decoded_rate = wifi_decode_rate(raw_rate)
    rate = decoded_rate.rate
    valid = decoded_rate.valid
        & (length != 0)
    header = ieee_signal_header(rate, length)
}

module IeeeDataFramer24 {
    clock clk reset rst

    in command : rv<WifiTxCommand>
    in psdu : rv<WifiPsduBeat>
    out signal : rv<bits<24>>
    out data : rv<WifiFramedWord>

    reg input_complete : bit = 0
    reg input_first : bit = 1
    reg output_first : bit = 1
    reg packet_rate : WifiRate = WifiRate.Continue
    reg remaining_bytes : u12 = 0

    // Occupied low-order byte lanes in pending_word.  A fresh packet starts
    // with two occupied zero SERVICE bytes.
    reg pending_word : bits<24> = 0
    reg occupied_bytes : u2 = 0
    reg pending_psdu_bytes : u2 = 0
    reg tail_mask_pending : bits<24> = 0
    reg symbol_slot : u2 = 0

    fifo signal_words : fifo<bits<24>,2>
    fifo framed_words : fifo<WifiFramedWord,2>

    decoded_command_rate = wifi_decode_rate(command.payload.rate)
    decoded_rate = decoded_command_rate.rate
    command_rate_valid = decoded_command_rate.valid

    expected_last = remaining_bytes <= 3
    expected_valid_bytes : u2 = expected_last
        ? truncate(remaining_bytes)
        : 3
    input_shape_valid = (psdu.payload.meta == expected_valid_bytes)
        & (psdu.payload.last == expected_last)
        & (psdu.payload.first == input_first)

    masked_psdu : bits<24> = psdu.payload.meta == 1
        ? (psdu.payload.data & 0x0000ff)
        : (psdu.payload.meta == 2
            ? (psdu.payload.data & 0x00ffff)
            : psdu.payload.data)
    masked_value : u24 = masked_psdu
    wide_psdu = extend<48>(masked_value)
    shifted_psdu : u48 = occupied_bytes == 0
        ? wide_psdu
        : (occupied_bytes == 1
            ? (wide_psdu << 8)
            : (wide_psdu << 16))
    pending_value : u24 = pending_word
    combined : u48 = extend<48>(pending_value) | shifted_psdu
    combined_bytes : u4 = extend<3>(occupied_bytes)
        + extend<3>(psdu.payload.meta)
    combined_psdu_bytes : u4 = extend<3>(pending_psdu_bytes)
        + extend<3>(psdu.payload.meta)
    emits_word = combined_bytes >= 3
    next_occupied : u2 = emits_word
        ? truncate(combined_bytes - 3)
        : truncate(combined_bytes)
    next_pending_word : bits<24> = emits_word
        ? combined[47:24]
        : combined[23:0]
    emitted_valid_bytes : u2 = output_first == 1 ? 1 : 3
    next_pending_psdu_bytes : u2 = emits_word
        ? truncate(combined_psdu_bytes - extend<4>(emitted_valid_bytes))
        : truncate(combined_psdu_bytes)

    symbol_last = wifi_symbol_slot_last(packet_rate, symbol_slot)
    next_symbol_slot : u2 = symbol_last
        ? 0
        : truncate(symbol_slot + 1)
    tail_mask_after_input : bits<24> = next_occupied == 0
        ? 0x00003f
        : (next_occupied == 1 ? 0x003f00 : 0x3f0000)

    emitted_meta = WifiWordMeta {
        rate = packet_rate
        valid_bytes = emitted_valid_bytes
        tail_mask = 0
        symbol_first = symbol_slot == 0
        symbol_last
    }
    emitted_beat : WifiFramedWord = FrameBeat {
        data = combined[23:0]
        meta = emitted_meta
        first = output_first
        last = 0
    }

    flush_meta = WifiWordMeta {
        rate = packet_rate
        valid_bytes = pending_psdu_bytes
        tail_mask = tail_mask_pending
        symbol_first = symbol_slot == 0
        symbol_last
    }
    flush_beat : WifiFramedWord = FrameBeat {
        data = pending_word
        meta = flush_meta
        first = output_first
        last = symbol_last
    }

    command.ready = (phase == IeeeFramerPhase.Idle)
        & signal_words.ready
        & command_rate_valid
        & (command.payload.length != 0)
    psdu.ready = (phase == IeeeFramerPhase.Active)
        & (input_complete == 0)
        & input_shape_valid
        & ((emits_word == 0) | framed_words.ready)

    signal.payload = signal_words.front
    signal.valid = signal_words.valid
    data.payload = framed_words.front
    data.valid = framed_words.valid

    fsm phase : IeeeFramerPhase = Idle {
        Idle {
            when command.transfer -> Active {
                signal_words.push(ieee_signal_header(
                    decoded_rate,
                    command.payload.length
                ))
                input_complete <- 0
                input_first <- 1
                output_first <- 1
                packet_rate <- decoded_rate
                remaining_bytes <- command.payload.length
                pending_word <- 0
                occupied_bytes <- 2
                pending_psdu_bytes <- 0
                tail_mask_pending <- 0
                symbol_slot <- 0
            }
        }
        Active {
            priority {
                when input_complete & framed_words.ready & symbol_last -> Idle {
                    framed_words.push(flush_beat)
                    input_complete <- 0
                    output_first <- 0
                    pending_word <- 0
                    occupied_bytes <- 0
                    pending_psdu_bytes <- 0
                    tail_mask_pending <- 0
                    symbol_slot <- next_symbol_slot
                    packet_rate <- WifiRate.Continue
                    remaining_bytes <- 0
                }
                when input_complete & framed_words.ready -> Active {
                    framed_words.push(flush_beat)
                    input_complete <- 1
                    output_first <- 0
                    pending_word <- 0
                    occupied_bytes <- 0
                    pending_psdu_bytes <- 0
                    tail_mask_pending <- 0
                    symbol_slot <- next_symbol_slot
                    remaining_bytes <- 0
                }
                when psdu.transfer -> Active {
                    when emits_word {
                        framed_words.push(emitted_beat)
                        output_first <- 0
                        symbol_slot <- next_symbol_slot
                    }
                    remaining_bytes <- truncate(
                        remaining_bytes - extend<12>(psdu.payload.meta)
                    )
                    input_complete <- psdu.payload.last
                    input_first <- 0
                    pending_word <- next_pending_word
                    occupied_bytes <- next_occupied
                    pending_psdu_bytes <- next_pending_psdu_bytes
                    tail_mask_pending <- psdu.payload.last
                        ? tail_mask_after_input
                        : 0
                }
            }
        }
    }

    retire_signal: when signal.transfer {
        signal_words.pop()
    }

    retire_data: when data.transfer {
        framed_words.pop()
    }

}

// Packet scrambling belongs beside framing because both share one accepted
// packet epoch.  Concise inferred locals below are immutable combinational
// values; only lfsr_state and the FIFO are stored across cycles.
module IeeeDataScrambler24 {
    clock clk reset rst

    in input : rv<WifiFramedWord>
    out output : rv<WifiFramedWord>

    reg lfsr_state : u7 = 0x4b
    fifo words : fifo<WifiFramedWord,2>

    s0 = input.payload.first ? 0x4b : lfsr_state
    feedback_taps : vec<24,u7> = [
        0x09, 0x12, 0x24, 0x48, 0x19, 0x32, 0x64, 0x41,
        0x0b, 0x16, 0x2c, 0x58, 0x39, 0x72, 0x6d, 0x53,
        0x2f, 0x5e, 0x35, 0x6a, 0x5d, 0x33, 0x66, 0x45
    ]
    // generate concisely describes the 24 independent LFSR tap evaluations;
    // the result is still a statically bounded vector, not a runtime loop.
    feedback = generate(i in 0..24)
        parity(s0 & feedback_taps[i])
    feedback_mask : bits<24> = feedback
    next_state : u7 = feedback_mask[23:17]
    scrambled = input.payload.data ^ feedback_mask
    forced_data = scrambled & ~input.payload.meta.tail_mask
    // `with` preserves every FrameBeat member and replaces only data.
    result : WifiFramedWord = input.payload with { data = forced_data }

    input.ready = words.ready
    output.payload = words.front
    output.valid = words.valid

    accept: when input.transfer {
        words.push(result)
        lfsr_state <- next_state
    }

    retire: when output.transfer {
        words.pop()
    }
}

module IeeePacketFramerScrambler24 {
    clock clk reset rst

    in command : rv<WifiTxCommand>
    in psdu : rv<WifiPsduBeat>
    out signal : rv<bits<24>>
    out data : rv<WifiFramedWord>

    framer : IeeeDataFramer24
    scrambler : IeeeDataScrambler24

    command -> framer.command
    psdu -> framer.psdu
    framer.signal -> signal
    framer.data -> scrambler.input
    scrambler.output -> data
}
