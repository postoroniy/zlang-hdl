// IEEE-authoritative K=7 convolutional encoder for the bounded 6/12/24 Mbit/s
// profile.  Encoding is an independently reusable PHY stage with its own
// history state, ready/valid boundary, and oracle coverage.

import wifi80211a_transmitter.scrambler
import std.coding.convolutional

// Raw scalar boundary retained as a small independently synthesizable witness
// for the otherwise functional encoder.
module IeeeConvolutionalEncode24 {
    in word : bits<24>
    in history : u6
    out result : ConvolutionalResult24

    result = ieee_convolutional_encode24(word, history)
}

// FrameBeat.first starts a fresh convolutional epoch. Struct destructuring
// and field punning keep the metadata-preserving path explicit but concise.
module IeeeConvolutionalEncoder24 {
    clock clk reset rst

    in input : rv<WifiFramedWord>
    out output : rv<WifiEncodedWord>

    reg history : u6 = 0
    fifo words : fifo<WifiEncodedWord,2>

    WifiFramedWord { data, meta, first, last } = input.payload
    selected_history = first ? 0 : history
    exact = ieee_convolutional_encode24(data, selected_history)
    encoded = FrameBeat {
        data = exact.encoded
        meta
        first
        last
    }

    input.ready = words.ready & (meta.rate != WifiRate.Continue)
    output.payload = words.front
    output.valid = words.valid

    accept: when input.transfer {
        words.push(encoded)
        history <- last ? 0 : exact.history
    }

    retire: when output.transfer {
        words.pop()
    }
}
