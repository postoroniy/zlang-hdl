import std.bus.reg
import std.bus.apb

module ApbCsrTop {
    clock clk
    reset rst
    interface apb : APB<32,32>.slave @clk

    frontend : APBToRegBus<32,32>
    csr      : RegBusCSRTarget<32,32>

    apb -> frontend.apb
    frontend.regbus -> csr.regbus
    out done : bit
    done = csr.done
}
