import std.bus.reg
import std.bus.apb

module ApbCsrTop {
    clock clk
    reset rst
    interface apb : APB<32,32>.slave @clk

    inst frontend : APBToRegBus<32,32>
    inst csr      : RegBusCSRTarget<32,32>

    connect apb -> frontend.apb
    connect frontend.regbus -> csr.regbus
    out done : bit
    done = csr.done
}
