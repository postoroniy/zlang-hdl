// Manual fixed-latency dot-product experiment.  The requested end-to-end
// contract is one cycle per coefficient, so the source
// exposes eight pipeline stages for Series-7 synthesis retiming.  No automatic
// exploration is used.
module DotProductPipelined {
    clock clk
    reset rst

    in  a : vec<8,u8>
    in  b : vec<8,u8>
    out y : u19

    y = pipeline(8) {
        sum(i in 0..8) a[i] * b[i]
    }
}
