    ]
}

fn crc32_output_128<O>(data : bits<128>, seed : bits<32>) -> bit {
    source = concat(data[127:0], seed)
    coefficients = crc32_masks_128()[O]
    reduce(^, bitcast<vec<160,bit>>(source & coefficients))
}

module CRCParallelWitness<N=32>
where N == 32 || N == 64 || N == 128 {
    in data : bits<128>
    in seed : bits<32>
    out crc : bits<32>

    crc = if N == 32 {
        pack(generate(output in 0..32) crc32_output_32<O=output>(data, seed))
    } else {
        if N == 64 {
            pack(generate(output in 0..32) crc32_output_64<O=output>(data, seed))
        } else {
            pack(generate(output in 0..32) crc32_output_128<O=output>(data, seed))
        }
    }
}
