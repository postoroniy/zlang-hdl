// Reflected CRC-32 update with polynomial 0xedb88320. The coefficient
// tables are the exact GF(2) linear transforms generated from the polynomial;
// the source remains a pure generic parity network rather than a handwritten
// XOR expression. Input bits are consumed least-significant first.
fn crc32_masks_32() -> vec<32,bits<64>> {
    [
        0x04d101df04d101df,
        0x09a203be09a203be,
        0x1344077d1344077d,
        0x26880efa26880efa,
        0x4d101df44d101df4,
        0x9a203be99a203be9,
        0x3091760d3091760d,
        0x6122ec1a6122ec1a,
        0xc245d835c245d835,
        0x805ab1b5805ab1b5,
        0x046462b5046462b5,
        0x08c8c56a08c8c56a,
        0x11918ad411918ad4,
        0x232315a9232315a9,
        0x46462b5346462b53,
        0x8c8c56a68c8c56a6,
        0x1dc9ac921dc9ac92,
        0x3b9359243b935924,
        0x7726b2497726b249,
        0xee4d6493ee4d6493,
        0xd84bc8f9d84bc8f9,
        0xb446902db446902d,
        0x6c5c21846c5c2184,
        0xd8b84309d8b84309,
        0xb5a187ccb5a187cc,
        0x6f920e466f920e46,
        0xdf241c8cdf241c8c,
        0xba9938c7ba9938c7,
        0x71e3705171e37051,
        0xe3c6e0a3e3c6e0a3,
        0xc35cc098c35cc098,
        0x826880ef826880ef
    ]
}
fn crc32_output_32<O>(data : bits<128>, seed : bits<32>) -> bit {
    source = concat(data[31:0], seed)
    coefficients = crc32_masks_32()[O]
    reduce(^, bitcast<vec<64,bit>>(source & coefficients))
}

