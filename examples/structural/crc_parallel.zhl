fn crc32_output_64<O>(data : bits<128>, seed : bits<32>) -> bit {
    source = concat(data[63:0], seed)
    coefficients = crc32_masks_64()[O]
    reduce(^, bitcast<vec<96,bit>>(source & coefficients))
}

