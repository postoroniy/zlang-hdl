// A regular compile-time-tap FIR. Coefficients are compile-time constants;
// products and the balanced source-order sum remain real hardware.
module FIRWitness<N=16> {
    in samples : vec<N,u16>
    out result : u32

    coefficients : vec<N,u16> = generate(i in 0..N)
        truncate(extend<16>(i) * 3 + 1)
    // Each u16 * u16 product is already an exact u32.
    products = generate(i in 0..N)
        samples[i] * coefficients[i]
    result = truncate(reduce(+, products))
}
