// Comparison point for the eight-term dot product: eight coefficient cycles
// plus four cycles of endpoint/internal-DSP register budget.  The total
// externally observable latency is exactly twelve cycles; Vivado retiming may
// redistribute, but must not add or remove, these registers.
module DotProductPipelined12 {
    clock clk
    reset rst

    in  a : vec<8,u8>
    in  b : vec<8,u8>
    out y : u19

    y = pipeline(12) {
        sum(i in 0..8) a[i] * b[i]
    }
}
