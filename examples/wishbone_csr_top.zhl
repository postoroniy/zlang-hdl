import std.bus.wishbone
import std.bus.reg

module WishboneCsrTop {
    clock clk
    reset rst
    interface wb : Wishbone<32,32>.slave @clk
    out done : bit

    frontend : WishboneToRegBus<32,32>
    csr : RegBusCSRTarget<32,32>
    wb -> frontend.wb
    frontend.regbus -> csr.regbus
    done = csr.done
}
