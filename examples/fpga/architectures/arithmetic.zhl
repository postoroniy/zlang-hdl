// Portable kernels for exact physical architecture selection; no board pins.

module Multiply1 {
    clock clk reset rst
    in a,b:s18
    out y:s36
    y=pipeline(1) { a*b }
}

module Multiply2 {
    clock clk reset rst
    in a,b:s18
    out y:s36
    y=pipeline(2) { a*b }
}

module Multiply3 {
    clock clk reset rst
    in a,b:s18
    out y:s36
    y=pipeline(3) { a*b }
}

module UnsignedMultiply1 {
    clock clk reset rst
    in a,b:u18
    out y:u36
    y=pipeline(1) { a*b }
}

module UnsignedMultiply2 {
    clock clk reset rst
    in a,b:u18
    out y:u36
    y=pipeline(2) { a*b }
}

module UnsignedMultiply3 {
    clock clk reset rst
    in a,b:u18
    out y:u36
    y=pipeline(3) { a*b }
}

module MultiplyAdd1 {
    clock clk reset rst
    in a,b:s18 in c:s53
    out y:s54
    y=pipeline(1) { a*b+c }
}

module MultiplyAdd2 {
    clock clk reset rst
    in a,b:s18 in c:s53
    out y:s54
    y=pipeline(2) { a*b+c }
}

module MultiplyAdd3 {
    clock clk reset rst
    in a,b:s18 in c:s53
    out y:s54
    y=pipeline(3) { a*b+c }
}

module PreaddMultiply1 {
    clock clk reset rst
    in a,d:s17 in b:s18
    out y:s36
    y=pipeline(1) { (a+d)*b }
}

module PreaddMultiply2 {
    clock clk reset rst
    in a,d:s17 in b:s18
    out y:s36
    y=pipeline(2) { (a+d)*b }
}

module PreaddMultiply3 {
    clock clk reset rst
    in a,d:s17 in b:s18
    out y:s36
    y=pipeline(3) { (a+d)*b }
}

module SignedReduction1 {
    clock clk reset rst
    in a,b,c,d:s18
    out y:s37
    y=pipeline(1) { a*b-c*d }
}

module SignedReduction2 {
    clock clk reset rst
    in a,b,c,d:s18
    out y:s37
    y=pipeline(2) { a*b-c*d }
}

module SignedReduction3 {
    clock clk reset rst
    in a,b,c,d:s18
    out y:s37
    y=pipeline(3) { a*b-c*d }
}

module Reduction41 {
    clock clk reset rst
    in a,b,c,d,e,f,g,h:s8
    out y:s19
    y=pipeline(1) { ((a*b+c*d)+e*f)+g*h }
}

module Reduction42 {
    clock clk reset rst
    in a,b,c,d,e,f,g,h:s8
    out y:s19
    y=pipeline(2) { ((a*b+c*d)+e*f)+g*h }
}

module Reduction43 {
    clock clk reset rst
    in a,b,c,d,e,f,g,h:s8
    out y:s19
    y=pipeline(3) { ((a*b+c*d)+e*f)+g*h }
}

struct ProductBundle1 { sum:s8 mirror:s8 }
module Parallel1 {
    clock clk reset rst
    in a0,a1,a2,b0,b1,b2:s4
    out y:ProductBundle1
    y=implement { ProductBundle1 { sum=a0*b0 mirror=a0*b0 } intent { dsp == 1 latency == 1 ii == 1 minimize lut } }
}

struct ProductBundle2 { sum:s9 mirror:s9 }
module Parallel2 {
    clock clk reset rst
    in a0,a1,a2,b0,b1,b2:s4
    out y:ProductBundle2
    y=implement { ProductBundle2 { sum=(a0*b0)+a0*b1 mirror=(a0*b0)+a0*b1 } intent { dsp == 2 latency == 1 ii == 1 minimize lut } }
}

struct ProductBundle3 { sum:s10 mirror:s10 }
module Parallel3 {
    clock clk reset rst
    in a0,a1,a2,b0,b1,b2:s4
    out y:ProductBundle3
    y=implement { ProductBundle3 { sum=((a0*b0)+a0*b1)+a0*b2 mirror=((a0*b0)+a0*b1)+a0*b2 } intent { dsp == 3 latency == 1 ii == 1 minimize lut } }
}

struct ProductBundle4 { sum:s11 mirror:s11 }
module Parallel4 {
    clock clk reset rst
    in a0,a1,a2,b0,b1,b2:s4
    out y:ProductBundle4
    y=implement { ProductBundle4 { sum=(((a0*b0)+a0*b1)+a0*b2)+a1*b0 mirror=(((a0*b0)+a0*b1)+a0*b2)+a1*b0 } intent { dsp == 4 latency == 1 ii == 1 minimize lut } }
}

