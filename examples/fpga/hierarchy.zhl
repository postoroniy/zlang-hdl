module FpgaDivider {
    clock clk
    reset rst_n @clk { mode synchronous polarity active_low power_up unspecified }
    out bit_out:bit
    reg count:u24=0
    count <- truncate<24>(count+1)
    bit_out=count[23]
}
module FpgaHierarchy {
    clock clk
    reset rst_n @clk {
        mode synchronous
        polarity active_low
        power_up unspecified
    }
    out led:bit
    divider:FpgaDivider
    led=divider.bit_out
}
