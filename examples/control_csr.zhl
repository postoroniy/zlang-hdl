module ControlCsr {
  clock clk
  reset rst

  csr control @ 0x4000_0000 {
    CONTROL @ 0x00 {
      enable bit @0 rw = 0
      mode u3 @3:1 rw = 0
      start bit @4 pulse
      command u3 @7:5 wo = 0
      reserved0 bits<24> @31:8 reserved
    }

    STATUS @ 0x04 {
      busy bit @0 ro = 1
      error bit @1 w1c = 1
      reserved1 bits<30> @31:2 reserved
    }
  }
}
