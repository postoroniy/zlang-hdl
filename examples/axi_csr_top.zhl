import std.bus.reg
import std.bus.axi_lite

module AxiCsrTop {
    clock clk
    reset rst
    interface axi : AXI4Lite<32,32>.slave @clk

    frontend : AXI4LiteToRegBus<32,32>
    csr      : RegBusCSRTarget<32,32>

    axi -> frontend.axi
    frontend.regbus -> csr.regbus
    out done : bit
    done = csr.done
}
