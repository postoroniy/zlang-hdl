module Producer {
    clock clk
    reset rst
    out tx:rv<u8>
    tx.payload = 7
    tx.valid = 1
}

module RequestFifo {
    clock clk
    reset rst
    in rx:rv<u8>
    out tx:rv<u8>
    connect rx -> tx { buffer 2 }
}

module Consumer {
    clock clk
    reset rst
    in rx:rv<u8>
    out seen:u8
    rx.ready = 1
    seen = rx.payload
}

module ProtocolTop {
    clock clk
    reset rst
    out seen:u8
    producer : Producer
    // `fifo` is also a storage keyword, so this instance deliberately uses
    // the explicit escape form instead of the otherwise preferred shorthand.
    inst fifo:RequestFifo
    consumer : Consumer
    producer.tx -> fifo.rx
    // A bare connection cannot begin with the `fifo` keyword.
    connect fifo.tx -> consumer.rx
    seen = consumer.seen
}
