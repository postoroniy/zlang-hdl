ARCHITECTURE_METRIC.3: /parallelism(?![A-Za-z0-9_])/ | /depth(?![A-Za-z0-9_])/ | /candidates(?![A-Za-z0-9_])/
ORDERING.3: /in_order(?![A-Za-z0-9_])/ | /out_of_order(?![A-Za-z0-9_])/
ADAPTER.3: /rv_to_credit(?![A-Za-z0-9_])/ | /credit_to_rv(?![A-Za-z0-9_])/
CSR_ACCESS.3: /(?:rw|ro|wo|w1c|pulse|reserved)(?![A-Za-z0-9_])/
CSR_PRIORITY.3: /hardware(?![A-Za-z0-9_])/ | /software(?![A-Za-z0-9_])/
MEMORY_COLLISION.3: /read_first(?![A-Za-z0-9_])/ | /write_first(?![A-Za-z0-9_])/
CDC_CROSSING.3: /sync_level(?![A-Za-z0-9_])/ | /pulse_toggle(?![A-Za-z0-9_])/ | /handshake(?![A-Za-z0-9_])/
ARBITRATION_POLICY.3: /fixed_priority(?![A-Za-z0-9_])/ | /round_robin(?![A-Za-z0-9_])/
GRANT_SCOPE.3: /beat(?![A-Za-z0-9_])/ | /packet(?![A-Za-z0-9_])/
CONTRACT_KIND.3: /assume(?![A-Za-z0-9_])/ | /guarantee(?![A-Za-z0-9_])/
// Declaration-shape lookahead keeps these words contextual: elsewhere the
// lexer still returns NAME, so ports and ordinary bindings may use them.
VERIFICATION_GOAL_KIND.4: /assert(?=[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*(?:[ \t]*@[ \t]*[A-Za-z_][A-Za-z0-9_]*)?[ \t\r\n]*\{)/ | /cover(?=[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*(?:[ \t]*@[ \t]*[A-Za-z_][A-Za-z0-9_]*)?[ \t\r\n]*\{)/
VERIFICATION_SCOPED_GOAL_KIND.4: /assert(?=[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*[ \t\r\n]*\{)/ | /ensure(?=[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*[ \t\r\n]*\{)/ | /cover(?=[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*[ \t\r\n]*\{)/
_VERIFICATION_CONTRACT.4: /contract(?=[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*(?:[ \t]*@[ \t]*[A-Za-z_][A-Za-z0-9_]*)?[ \t\r\n]*\{)/
_VERIFICATION_REQUIRE.4: /require(?=[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*[ \t\r\n]*\{)/
IMPLEMENTATION_KIND.3: /mul_add(?![A-Za-z0-9_])/ | /dsp_mac(?![A-Za-z0-9_])/
COST_METRIC.3: /lut(?![A-Za-z0-9_])/ | /ff(?![A-Za-z0-9_])/ | /dsp(?![A-Za-z0-9_])/ | /bram(?![A-Za-z0-9_])/ | /latency(?![A-Za-z0-9_])/ | /ii(?![A-Za-z0-9_])/ | /fmax_est(?![A-Za-z0-9_])/ | /fmax(?![A-Za-z0-9_])/
EXPLORATION_FAMILY.3: /pipeline(?![A-Za-z0-9_])/ | /dsp(?![A-Za-z0-9_])/ | /reduction(?![A-Za-z0-9_])/ | /reassociate(?![A-Za-z0-9_])/ | /adapter(?![A-Za-z0-9_])/
EXPLORE_RELATION.3: "<=" | ">=" | "=="
SYNTHESIS_FEEDBACK.3: /optional_yosys(?![A-Za-z0-9_])/
ROUNDING_MODE.4: /toward_zero(?![A-Za-z0-9_])/ | /floor(?![A-Za-z0-9_])/ | /away_zero(?![A-Za-z0-9_])/ | /nearest_even(?![A-Za-z0-9_])/
OVERFLOW_MODE.4: /wrap(?![A-Za-z0-9_])/ | /saturate(?![A-Za-z0-9_])/
OPERATOR_SYMBOL.4: "+" | "-" | "*"
_CALL_LANGLE.10: /<(?=(?:[^<>\n]|<(?:[^<>\n]|<[^<>\n]*>)*>)+>\s*\()/
