// A fully combinational, unrolled integer-mixing datapath. This is a natural
// shape for hash/address-mixing hardware and intentionally retains substantial
// arithmetic depth without relying on generated regions.
module NativeJitLargeCombinationalBenchmark {
    in seed : u32
    out result : u32

    state_00 : u32 = seed
    state_01 : u32 = truncate<32>((state_00 ^ (state_00 >> 7)) + 0x9e3779b9)
    state_02 : u32 = truncate<32>((state_01 ^ (state_01 << 9)) + 0x7f4a7c15)
    state_03 : u32 = truncate<32>((state_02 ^ (state_02 >> 11)) + 0x94d049bb)
    state_04 : u32 = truncate<32>((state_03 ^ (state_03 << 5)) + 0xed5ad4bb)
    state_05 : u32 = truncate<32>((state_04 ^ (state_04 >> 7)) + 0xac4c1b51)
