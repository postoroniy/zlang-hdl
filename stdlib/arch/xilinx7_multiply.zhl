import std.target.xilinx.series7

// One exact full-width scalar product.  The mapper validates physical widths
// from the resource definition and chooses a declared DSP48E1 configuration.
architecture Xilinx7Multiply {
    operation multiply
    require_resource DSP48E1 1
    latency 1
    ii 1
    use_pipeline unregistered
}

architecture Xilinx7MultiplyMREG {
    operation multiply
    require_resource DSP48E1 1
    latency 2
    ii 1
    use_pipeline multiply_registered
}

architecture Xilinx7MultiplyMREGPREG {
    operation multiply
    require_resource DSP48E1 1
    latency 3
    ii 1
    use_pipeline multiply_output_registered
}

architecture Xilinx7MultiplyFullyPipelined {
    operation multiply
    require_resource DSP48E1 1
    latency 4
    ii 1
    use_pipeline fully_pipelined
}

module Xilinx7MultiplyArchitectureLibrary {}
