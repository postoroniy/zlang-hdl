import std.target.xilinx.series7

// Parallel independent full-width products; one optional joint output stage.
architecture Xilinx7ParallelProducts1 {
    operation parallel_bilinear
    require_resource DSP48E1 1
    latency 1
    ii 1
    use_pipeline unregistered
}
