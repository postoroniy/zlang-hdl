import std.math.fp_format

// Exact input is magnitude*2^scale. Bit zero may carry a right-shift sticky
// bit. Tininess is after rounding.
fn fp_round_pack<E,F,M,W=1+E+F,X=E+5,P=F+4,Q=F+2,L=M+F+4>(sign:bit,magnitude:bits<M>,scale:sint<E+5>,rounding:u3) -> FpResult {
    check_exponent_width = bitcast<bits<X>>(zeros<E+5>)
    _fp_round_pack_scaled<E=E,F=F,M=M,S=E+5,W=W,X=X,P=P,Q=Q,L=L>(
        sign,magnitude,scale,rounding)
}

// Keep the exact incoming scale through range classification, including when
// converting from a source format with a larger exponent range.
fn _fp_round_pack_scaled<E,F,M,S,W=1+E+F,X=E+5,P=F+4,Q=F+2,L=M+F+4,B=M>(
    sign:bit,magnitude:bits<M>,scale:sint<S>,rounding:u3) -> FpResult {
    // The highest set bit ranges from zero through M-1 in the signed X-bit lane.
    check_highest_width = bitcast<bits<1>>(
        if M <= (1 << (X-1)) { zeros<1> } else { zeros<2> })
    // An aligned sum has two bounded chunks and a carry. Neither chunk
    // needs a reduction over the entire widened alignment lane.
    low = if B == M { magnitude } else { magnitude[B-1:0] }
    low_length = if B < 256 { fp_bit_length<M=B>(low) }
        else { _fp_bit_length_wide<M=B,B=X>(low) }
    high_length = if B >= M-1 { extend<X>(0) }
        else { _fp_bit_length_wide<M=M-B-1,B=X>(magnitude[M-2:B]) }
    length = if B == M { extend<X>(low_length) }
        else {
            magnitude[M-1] ? extend<X>(M) : high_length == 0 ? extend<X>(low_length)
                : truncate<X>(high_length+B)
        }
    highest = bitcast<sint<X>>(truncate<X>(length-1))
    // The signed sum grows beyond both operands. Classify it before narrowing.
    exponent = scale+highest
    distance = highest-(F+3)
    wide = extend<L>(magnitude)
    normalized_wide = distance >= 0
        ? fp_shift_jam<M=M+F+4>(wide,extend<16>(bitcast<uint<X>>(truncate<X>(distance))))
        : wide << extend<16>(bitcast<uint<X>>(truncate<X>(-distance)))
    normalized = truncate<P>(normalized_wide)
    minimum = bitcast<sint<X>>(extend<X>(2-(1 << (E-1))))
    maximum = bitcast<sint<X>>(extend<X>((1 << (E-1))-1))
    below_minimum = exponent < minimum
    above_maximum = exponent > maximum
    denormal_gap = minimum-exponent
    // Once all F+4 bits are shifted out, only their sticky bit matters.
    bounded_gap = denormal_gap >= F+4 ? extend<16>(F+4)
        : if X+2 <= 16 && S+2 <= 16 { bitcast<u16>(extend<16>(denormal_gap)) }
          else { bitcast<u16>(truncate<16>(denormal_gap)) }
    denormal_shift = below_minimum ? bounded_gap : 0
    aligned = fp_shift_jam<M=F+4>(normalized,denormal_shift)
    // In-range exponents and the rounding carry fit the original signed lane.
    effective_exponent = below_minimum ? minimum : above_maximum ? maximum : truncate<X>(exponent)
    discarded = aligned[2:0]
    increment = fp_round_increment(sign,rounding,discarded,aligned[3])
    rounded = extend<Q>(bitcast<uint<F+1>>(aligned[F+3:3])) + extend<Q>(bitcast<uint<1>>(increment))
    significand = bitcast<bits<Q>>(truncate<Q>(rounded))
    carry = significand[F+1]
    final_exponent = truncate<X>(effective_exponent+bitcast<sint<X>>(extend<X>(bitcast<bits<1>>(carry))))
    final_significand = carry ? significand >> 1 : significand
    tiny = (final_exponent == minimum) & ~final_significand[F]
    overflow = above_maximum | (final_exponent > maximum)
    inexact = discarded != 0
    field = tiny ? zeros<E> : truncate<E>(bitcast<bits<X>>(truncate<X>(final_exponent+((1 << (E-1))-1))))
    finite = concat(bitcast<bits<1>>(sign),field,final_significand[F-1:0])
    to_infinity = (rounding == 0) | (rounding == 4) |
        ((rounding == 2) & sign) | ((rounding == 3) & ~sign)
    largest = concat(bitcast<bits<1>>(sign),bitcast<bits<E>>((1 << E)-2),bitcast<bits<F>>((1 << F)-1))
    result = magnitude == 0 ? concat(bitcast<bits<1>>(sign),zeros<E+F>)
        : overflow ? (to_infinity ? fp_infinity<E=E,F=F>(sign) : largest) : finite
    FpResult {value=extend<64>(result)
        flags=magnitude == 0 ? 0 : overflow ? 5 : (tiny & inexact) ? 3 : inexact ? 1 : 0
        illegal=rounding > 4}
}

// Aligned signed magnitude addition. K is the exact binary point of both
// input magnitudes relative to their leading unbiased exponent.
fn fp_sum<E,F,M,K,X=E+5>(a:bits<M>,b:bits<M>,ea:sint<E+5>,eb:sint<E+5>,
    sa:bit,sb:bit,rounding:u3) -> FpResult {
    check_exponent_width = bitcast<bits<X>>(zeros<E+5>)
    check_highest_width = bitcast<bits<1>>(
        if M <= (1 << (X-1)) { zeros<1> } else { zeros<2> })
    if M >= F+4 { _fp_sum_aligned<E=E,F=F,M=M,K=K,P=M>(a,b,ea,eb,sa,sb,rounding) }
    else { _fp_sum_aligned<E=E,F=F,M=M,K=K,P=F+4>(a,b,ea,eb,sa,sb,rounding) }
}

fn _fp_sum_aligned<E,F,M,K,P,X=E+5,A=M+P>(a:bits<M>,b:bits<M>,ea:sint<E+5>,eb:sint<E+5>,
    sa:bit,sb:bit,rounding:u3) -> FpResult {
    // A zero product/addend has no leading exponent. Letting its arbitrary
    // decoded exponent dominate alignment can erase an exact tiny addend.
    exponent = a == 0 ? eb : b == 0 ? ea : ea > eb ? ea : eb
    // The difference of two X-bit signed exponents fits X unsigned bits.
    da = extend<16>(bitcast<uint<X>>(truncate<X>(exponent-ea)))
    db = extend<16>(bitcast<uint<X>>(truncate<X>(exponent-eb)))
    // An operand can lose bits only after shifting beyond P. Then even its
    // highest bit is below half of the unshifted nonzero operand's unit.
    // This bounds cancellation and leaves G/R/S intact through packing.
    left = fp_shift_jam<M=A>(concat(a,zeros<P>),da)
    right = fp_shift_jam<M=A>(concat(b,zeros<P>),db)
    same = sa == sb
    unsigned_left = bitcast<uint<A>>(left)
    unsigned_right = bitcast<uint<A>>(right)
    larger = unsigned_left >= unsigned_right
    difference = larger ? unsigned_left-unsigned_right : unsigned_right-unsigned_left
    magnitude = same ? bitcast<bits<A+1>>(unsigned_left+unsigned_right)
        : concat(zeros<1>,bitcast<bits<A>>(difference))
    sign = magnitude == 0 ? (same ? sa : rounding == 2) : larger ? sa : sb
    scale = exponent-K-P
    if A < (1 << (X-1)) {
        _fp_round_pack_scaled<E=E,F=F,M=A+1,S=E+7,B=M>(sign,magnitude,scale,rounding)
    } else {
        _fp_round_pack_scaled<E=E,F=F,M=A+1,S=E+7,X=floor_log2(A)+2,B=M>(
            sign,magnitude,scale,rounding)
    }
}
