// Source-authored storage wrappers over the existing semantic primitives.
// `delay<N>` currently requires a literal N, so bounded common depths are
// separate ordinary modules rather than a misleading generic wrapper.
module StorageDelay1<type T> {
    clock clk
    reset rst
    in input : T
    out output : T

    output = delay<1>(input)
}

module StorageDelay2<type T> {
    clock clk
    reset rst
    in input : T
    out output : T

    output = delay<2>(input)
}

// A protocol-neutral atomic capture primitive.  CSR command snapshots are
// ordinary typed state: connect a compiler-qualified bank event to `capture`
// and a structural state view to `input`; no CSR-specific scheduler exists.
module StorageSnapshot<type T,reset_value:fn()->T> {
    clock clk
    reset rst
    in input : T
    in capture : bit
    out output : T

    reg captured : T = reset_value()
    when capture {
        captured <- input
    }
    output = captured
}

module StorageQueue<type T,D=2,CW=2> {
    clock clk
    reset rst
    in push : bit
    in pop : bit
    in data : T
    out front : T
    out valid : bit
    out ready : bit
    out count : uint<CW>

    fifo storage : fifo<T,D>
    storage.data = data
    storage.push = push
    storage.pop = pop
    front = storage.front
    valid = storage.valid
    ready = storage.ready
    count = storage.count
}

// Immutable images are compile-time specialization arguments, never runtime
// ports.  The concrete image is hashed into the child specialization and the
// existing ROM companion artifact.
module StorageRom<type T,N,IW,image:vec<N,T>>
where N >= 2 && is_power_of_two(N) && IW == floor_log2(N) {
    clock clk
    reset rst
    in address : uint<IW>
    out data : T

    rom table : rom<T,N> {
        read_latency 1
        init image
    }
    table.read_address = address
    data = table.read_data
}

// A statically selected zero-argument producer is specialized and evaluated
// during elaboration.  It is not a runtime function pointer or a backend
// callback.
module StorageGeneratedRom<type T,N,IW,producer:fn()->vec<N,T>>
where N >= 2 && is_power_of_two(N) && IW == floor_log2(N) {
    clock clk
    reset rst
    in address : uint<IW>
    out data : T

    rom table : rom<T,N> {
        read_latency 1
        init producer()
    }
    table.read_address = address
    data = table.read_data
}

// A generic raw-bit reorder bank. The caller owns the permutation and
// occupancy policy; this wrapper supplies deterministic range-checked indexed
// storage with one write per cycle. A typed caller may use explicit bitcast at
// this representation boundary.
module StorageReorderBits<W=8,N=8>
where N >= 2 && is_power_of_two(N) {
    clock clk
    reset rst
    in write : bit
    in write_index : uint<floor_log2(N)>
    in write_data : bits<W>
    in read_index : uint<floor_log2(N)>
    out read_data : bits<W>

    reg entries : vec<N,bits<W>> = generate(i in 0..N) 0
    when write {
        entries[write_index] <- write_data
    }
    read_data = entries[read_index]
}

// Two raw-bit banks permit one completed block to be read while the other is
// filled. `commit` publishes the current write bank and changes banks;
// `retire` releases the current read bank. The explicit valid bits prevent a
// writer from overwriting an unconsumed block.
struct StoragePingPongStatus<W=8> {
    write_ready : bit
    commit_ready : bit
    read_valid : bit
    read_data : bits<W>
}

module StoragePingPongBits<W=8,N=8>
where N >= 2 && is_power_of_two(N) {
    clock clk
    reset rst
    in write : bit
    in write_index : uint<floor_log2(N)>
    in write_data : bits<W>
    in commit : bit
    in retire : bit
    in read_index : uint<floor_log2(N)>
    out status : StoragePingPongStatus<W>

    reg bank0 : vec<N,bits<W>> = generate(i in 0..N) 0
    reg bank1 : vec<N,bits<W>> = generate(i in 0..N) 0
    reg write_bank : bit = 0
    reg valid0 : bit = 0
    reg valid1 : bit = 0

    write_open = write_bank ? ~valid1 : ~valid0
    read_available = write_bank ? valid0 : valid1
    commit_open = write_open & ((read_available == 0) | retire)
    status = StoragePingPongStatus {
        write_ready = write_open
        commit_ready = commit_open
        read_valid = read_available
        read_data = write_bank ? bank0[read_index] : bank1[read_index]
    }

    when write & write_open & (write_bank == 0) {
        bank0[write_index] <- write_data
    }
    when write & write_open & write_bank {
        bank1[write_index] <- write_data
    }

    write_bank <- commit & commit_open ? ~write_bank : write_bank
    valid0 <- retire & write_bank & valid0
        ? 0
        : (commit & commit_open & (write_bank == 0) ? 1 : valid0)
    valid1 <- retire & (write_bank == 0) & valid1
        ? 0
        : (commit & commit_open & write_bank ? 1 : valid1)
}

// Ordinary source wrapper around the existing explicit asynchronous FIFO
// crossing. It introduces no second FIFO primitive and no implicit CDC.
module StorageAsyncFifo<type T,D=4> {
    clock write_clk
    reset write_rst @write_clk
    clock read_clk
    reset read_rst @read_clk
    in source : rv<T> @write_clk
    out sink : rv<T> @read_clk

    connect source -> sink {
        crossing async_fifo(D)
    }
}

// Same-clock true dual-port logical memory. Physical selection may use a
// matching native resource or the bounded generic register/mux realization.
module StorageDualPortMemory<type T,N,AW>
where N >= 2 && is_power_of_two(N) && AW == floor_log2(N) {
    clock clk
    reset rst
    in a_read : bit
    in a_write : bit
    in a_address : uint<AW>
    in a_write_data : T
    out a_read_data : T
    in b_read : bit
    in b_write : bit
    in b_address : uint<AW>
    in b_write_data : T
    out b_read_data : T

    memory storage : mem<T,N> {
        read_write_port a
        read_write_port b
        read_latency 1
        collision old
        write_priority a > b
    }
    storage.a.read_enable = a_read
    storage.a.write_enable = a_write
    storage.a.address = a_address
    storage.a.write_data = a_write_data
    storage.b.read_enable = b_read
    storage.b.write_enable = b_write
    storage.b.address = b_address
    storage.b.write_data = b_write_data
    a_read_data = storage.a.data
    b_read_data = storage.b.data
}

// A one-writer/two-reader shape is deterministically implemented as coherent
// replicated 1R1W memories when no exact native resource is selected.
module Storage2R1WMemory<type T,N,AW>
where N >= 2 && is_power_of_two(N) && AW == floor_log2(N) {
    clock clk
    reset rst
    in write : bit
    in write_address : uint<AW>
    in write_data : T
    in read0 : bit
    in read0_address : uint<AW>
    out read0_data : T
    in read1 : bit
    in read1_address : uint<AW>
    out read1_data : T

    memory storage : mem<T,N> {
        write_port write
        read_port read0
        read_port read1
        read_latency 1
        collision old
    }
    storage.write.enable = write
    storage.write.address = write_address
    storage.write.data = write_data
    storage.read0.read_enable = read0
    storage.read0.address = read0_address
    storage.read1.read_enable = read1
    storage.read1.address = read1_address
    read0_data = storage.read0.data
    read1_data = storage.read1.data
}

// The bounded independent-clock writable-memory shape: one write-only source
// domain and one read-only destination domain.
module StorageAsyncMemory1W1R<type T,N,AW>
where N >= 2 && is_power_of_two(N) && AW == floor_log2(N) {
    clock write_clk
    reset write_rst @write_clk
    clock read_clk
    reset read_rst @read_clk
    in write : bit @write_clk
    in write_address : uint<AW> @write_clk
    in write_data : T @write_clk
    in read_address : uint<AW> @read_clk
    out read_data : T @read_clk

    memory storage : async_mem<T,N> {
        write_port write @write_clk
        read_port read @read_clk
        read_latency 1
        collision old
        reset { contents preserve read_data clear }
    }
    storage.write.enable = write
    storage.write.address = write_address
    storage.write.data = write_data
    storage.read.address = read_address
    read_data = storage.read.data
}
