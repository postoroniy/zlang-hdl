// Bounded vector-to-stream serialization using existing ready/valid and FIFO
// semantics.  N must be a power of two and at least two in this first source
// implementation. The declaration rejects incoherent specializations before
// any storage or backend lowering is attempted.
module RvVectorSerializer<type T,N=8,IW=3>
where N >= 2 && is_power_of_two(N) && IW == floor_log2(N) {
    clock clk
    reset rst

    in input : rv<vec<N,T>>
    out output : rv<T>

    fifo vectors : fifo<vec<N,T>,2>
    reg index : uint<IW> = 0

    last = index == (N - 1)
    retiring = output.transfer & last
    input.ready = vectors.ready | retiring
    output.valid = vectors.valid
    output.payload = vectors.front[index]

    rule accept when input.transfer {
        vectors.push(input.payload)
    }

    rule advance when output.transfer {
        index <- last ? 0 : truncate<IW>(index + 1)
    }

    rule retire when retiring {
        vectors.pop()
    }
}

// A bit collector is useful at raw serialization boundaries and does not need
// an implicit default value for an arbitrary generic T.
module RvBitCollector<N=8,IW=3>
where N >= 2 && is_power_of_two(N) && IW == floor_log2(N) {
    clock clk
    reset rst

    in input : rv<bit>
    out output : rv<bits<N>>

    reg collected : vec<N,bit> = generate(i in 0..N) 0
    reg index : uint<IW> = 0
    reg full : bit = 0

    // The completed word may retire while the first bit of the next word is
    // accepted; the explicit priority preserves the new collect action.
    input.ready = (full == 0) | output.transfer
    output.valid = full
    output.payload = bitcast<bits<N>>(collected)

    rule collect when input.transfer {
        collected[index] <- input.payload
        index <- index == (N - 1)
            ? 0
            : truncate<IW>(index + 1)
        full <- index == (N - 1)
    }

    rule retire when output.transfer {
        full <- 0
    }

    priority collect > retire
}
