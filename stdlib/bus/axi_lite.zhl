// Compiler-shipped AXI4-Lite source profile (initial 32/32 slice).
import std.bus.reg
struct AxiLiteAw<AW=32> { addr : uint<AW> }
struct AxiLiteW<DW=32> { data : uint<DW> strb : bits<DW/8> }
struct AxiLiteB { resp : bits<2> }
struct AxiLiteR<DW=32> { data : uint<DW> resp : bits<2> }

protocol AXI4Lite<AW=32,DW=32> {
    role master
    role slave
    channel aw : rv<AxiLiteAw<AW>> master -> slave
    channel w  : rv<AxiLiteW<DW>> master -> slave
    channel b  : rv<AxiLiteB> slave -> master
    channel ar : rv<AxiLiteAw<AW>> master -> slave
    channel r  : rv<AxiLiteR<DW>> slave -> master
}

// This complete source-authored bridge is compiled through generic aggregate
// endpoints, hierarchy, state and ready/valid lowering. Neither backend has an
// AXI-specific dispatcher. Error responses are retained as SLVERR while B/R
// channels are stalled.
module AXI4LiteToRegBus<AW=32,DW=32> {
    clock clk
    reset rst
    interface axi : AXI4Lite<AW,DW>.slave @clk
    interface regbus : RegBus<AW,DW>.requester @clk

    reg aw_pending : bit = 0
    reg aw_addr : uint<AW> = 0
    reg w_pending : bit = 0
    reg w_data : uint<DW> = 0
    reg w_strb : bits<DW/8> = 0
    reg ar_pending : bit = 0
    reg ar_addr : uint<AW> = 0
    reg write_active : bit = 0
    reg read_active : bit = 0
    reg b_pending : bit = 0
    reg b_resp : bits<2> = 0
    reg r_pending : bit = 0
    reg r_data : uint<DW> = 0
    reg r_resp : bits<2> = 0

    aw_free : bit = mux(aw_pending, 0, 1)
    w_free : bit = mux(w_pending, 0, 1)
    ar_free : bit = mux(ar_pending, 0, 1)
    idle : bit = mux(write_active, 0, mux(read_active, 0, 1))
    write_can : bit = mux(aw_pending, mux(w_pending, mux(idle, mux(b_pending, 0, 1), 0), 0), 0)
    read_can : bit = mux(ar_pending, mux(idle, mux(write_can, 0, mux(r_pending, 0, 1)), 0), 0)

    axi.aw.ready = mux(aw_free, mux(b_pending, 0, 1), 0)
    axi.w.ready = mux(w_free, mux(b_pending, 0, 1), 0)
    axi.ar.ready = mux(ar_free, mux(idle, mux(r_pending, 0, 1), 0), 0)
    axi.b.valid = b_pending
    axi.b.payload = AxiLiteB{resp=b_resp}
    axi.r.valid = r_pending
    axi.r.payload = AxiLiteR{data=r_data resp=r_resp}

    regbus.request.valid = mux(write_can, 1, read_can)
    regbus.request.payload = RegRequest{addr=mux(write_can,aw_addr,ar_addr) write=write_can wdata=w_data wstrb=w_strb}
    regbus.response.ready = mux(write_active, 1, read_active)

    aw_pending <- mux(axi.aw.transfer, 1, mux(mux(write_can, regbus.request.ready, 0), 0, aw_pending))
    aw_addr <- mux(axi.aw.transfer, axi.aw.payload.addr, aw_addr)
    w_pending <- mux(axi.w.transfer, 1, mux(mux(write_can, regbus.request.ready, 0), 0, w_pending))
    w_data <- mux(axi.w.transfer, axi.w.payload.data, w_data)
    w_strb <- mux(axi.w.transfer, axi.w.payload.strb, w_strb)
    ar_pending <- mux(axi.ar.transfer, 1, mux(mux(read_can, regbus.request.ready, 0), 0, ar_pending))
    ar_addr <- mux(axi.ar.transfer, axi.ar.payload.addr, ar_addr)
    write_active <- mux(mux(write_can, regbus.request.ready, 0), 1, mux(mux(regbus.response.transfer, write_active, 0), 0, write_active))
    read_active <- mux(mux(read_can, regbus.request.ready, 0), 1, mux(mux(regbus.response.transfer, read_active, 0), 0, read_active))
    b_pending <- mux(mux(regbus.response.transfer, write_active, 0), 1, mux(axi.b.transfer, 0, b_pending))
    b_resp <- mux(mux(regbus.response.transfer, write_active, 0), mux(regbus.response.payload.error, 2, 0), b_resp)
    r_pending <- mux(mux(regbus.response.transfer, read_active, 0), 1, mux(axi.r.transfer, 0, r_pending))
    r_data <- mux(mux(regbus.response.transfer, read_active, 0), regbus.response.payload.rdata, r_data)
    r_resp <- mux(mux(regbus.response.transfer, read_active, 0), mux(regbus.response.payload.error, 2, 0), r_resp)

}
