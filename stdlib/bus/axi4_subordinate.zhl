// Bounded transaction adapters for a five-channel AXI4 subordinate.  Slot
// tokens belong to this endpoint, not to AXI; the backend must return the
// token with each result.  No compiler path recognizes these module names.
import std.bus.axi4

struct Axi4BackendReadRequest<AW=32,RIW=4,SW=2> {
    slot : bits<SW>
    address : Axi4Address<AW,RIW>
}

struct Axi4BackendReadBeat<DW=32,SW=2> {
    slot : bits<SW>
    data : bits<DW>
    resp : bits<2>
    last : bit
}

module AXI4ReadSubordinate<AW=32,DW=32,RIW=4,D=4,SW=2,EXCLUSIVE=0>
where AW >= 1 && AW <= 64 && RIW >= 1 && RIW <= 32 &&
      DW >= 8 && DW <= 1024 && is_power_of_two(DW) &&
      D >= 2 && is_power_of_two(D) && SW == floor_log2(D) &&
      EXCLUSIVE >= 0 && EXCLUSIVE <= 1 {
    clock clk reset rst
    interface axi : AXI4Read<AW,DW,RIW>.slave @clk
    out backend_request : rv<Axi4BackendReadRequest<AW,RIW,SW>>
    in backend_beat : rv<Axi4BackendReadBeat<DW,SW>>
    out protocol_error : bit

    reg occupied : vec<D,bit> = generate(i in 0..D) 0
    reg invalid : vec<D,bit> = generate(i in 0..D) 0
    reg ids : vec<D,bits<RIW>> = generate(i in 0..D) 0
    reg exclusive : vec<D,bit> = generate(i in 0..D) 0
    // Beats not yet admitted to the one-beat output holding register.
    reg remaining : vec<D,u9> = generate(i in 0..D) 0
    reg older : vec<D,vec<D,bit>> = generate(i in 0..D)
        generate(j in 0..D) 0
    reg output_valid : bit = 0
    reg output_slot : bits<SW> = 0
    reg output_payload : Axi4ReadData<DW,RIW> = Axi4ReadData {
        id=0 data=0 resp=0 last=0
    }
    reg failed : bit = 0

    free = generate(i in 0..D)
        (~occupied[i] & ~reduce(|, generate(j in 0..D)
            ((j < i) & ~occupied[j])))
    has_free = reduce(|, free)
    free_slot = reduce(|, generate(i in 0..D)
        mux(free[i], bitcast<bits<SW>>(truncate<SW>(i)), zeros<SW>))
    legal = axi4_address_valid<AW=AW,DW=DW,IW=RIW>(axi.ar.payload) &
        (~axi.ar.payload.lock |
         axi4_exclusive_address_valid<AW=AW,DW=DW,IW=RIW>(axi.ar.payload))
    backend_request.valid = axi.ar.valid & has_free & legal
    backend_request.payload = Axi4BackendReadRequest {
        slot=free_slot address=axi.ar.payload
    }
    axi.ar.ready = has_free & (~legal | backend_request.ready)

    eligible = generate(i in 0..D)
        (occupied[i] & (remaining[i] != 0) &
         ~reduce(|, generate(j in 0..D) (older[i][j] & occupied[j])))
    invalid_candidate = generate(i in 0..D) (eligible[i] & invalid[i])
    invalid_selected = generate(i in 0..D)
        (invalid_candidate[i] & ~reduce(|, generate(j in 0..D)
            ((j < i) & invalid_candidate[j])))
    has_invalid = reduce(|, invalid_selected)
    selected_invalid_slot = reduce(|, generate(i in 0..D)
        mux(invalid_selected[i],
            bitcast<bits<SW>>(truncate<SW>(i)), zeros<SW>))
    selected_invalid_id = reduce(|, generate(i in 0..D)
        mux(invalid_selected[i], ids[i], zeros<RIW>))
    selected_invalid_last = reduce(|, generate(i in 0..D)
        (invalid_selected[i] & (remaining[i] == 1)))
    backend_selected = generate(i in 0..D)
        (eligible[i] & ~invalid[i] &
         (backend_beat.payload.slot == bitcast<bits<SW>>(truncate<SW>(i))))
    has_backend_slot = reduce(|, backend_selected)
    selected_backend_id = reduce(|, generate(i in 0..D)
        mux(backend_selected[i], ids[i], zeros<RIW>))
    selected_backend_exclusive = reduce(|, generate(i in 0..D)
        (backend_selected[i] & exclusive[i]))
    selected_backend_last = reduce(|, generate(i in 0..D)
        (backend_selected[i] & (remaining[i] == 1)))
    can_fill = ~output_valid | axi.r.ready
    fill_invalid = can_fill & has_invalid
    fill_backend = can_fill & ~has_invalid &
                   backend_beat.valid & has_backend_slot
    fill = fill_invalid | fill_backend
    backend_beat.ready = can_fill & ~has_invalid & has_backend_slot

    axi.r.valid = output_valid
    axi.r.payload = output_payload
    protocol_error = failed

    retiring = generate(i in 0..D)
        (axi.r.transfer & output_payload.last &
         (output_slot == bitcast<bits<SW>>(truncate<SW>(i))))
    occupied <- generate(i in 0..D)
        mux(axi.ar.transfer & free[i], 1,
            mux(retiring[i], 0, occupied[i]))
    invalid <- generate(i in 0..D)
        mux(axi.ar.transfer & free[i], ~legal,
            mux(retiring[i], 0, invalid[i]))
    ids <- generate(i in 0..D)
        mux(axi.ar.transfer & free[i], axi.ar.payload.id, ids[i])
    exclusive <- generate(i in 0..D)
        mux(axi.ar.transfer & free[i], axi.ar.payload.lock,
            mux(retiring[i], 0, exclusive[i]))
    remaining <- generate(i in 0..D)
        mux(axi.ar.transfer & free[i],
            truncate<9>(extend<9>(axi.ar.payload.len) + 1),
            mux((fill_invalid & invalid_selected[i]) |
                (fill_backend & backend_selected[i]),
                truncate<9>(remaining[i] - 1), remaining[i]))
    older <- generate(i in 0..D)
        generate(j in 0..D)
            mux(axi.ar.transfer & free[i],
                occupied[j] & (ids[j] == axi.ar.payload.id) & ~retiring[j],
                older[i][j] & ~retiring[j])
    output_valid <- mux(fill, 1,
                        mux(axi.r.transfer, 0, output_valid))
    output_slot <- mux(fill_invalid, selected_invalid_slot,
                       mux(fill_backend, backend_beat.payload.slot,
                           output_slot))
    output_payload <- mux(fill_invalid,
        Axi4ReadData { id=selected_invalid_id data=0 resp=3
                       last=selected_invalid_last },
        mux(fill_backend,
            Axi4ReadData {
                id=selected_backend_id data=backend_beat.payload.data
                // A non-exclusive-capable subordinate never claims EXOKAY.
                resp=mux((backend_beat.payload.resp == 1) &
                         ~((EXCLUSIVE == 1) & selected_backend_exclusive),
                         zeros<2>, backend_beat.payload.resp)
                last=selected_backend_last
            }, output_payload))
    when axi.ar.transfer | backend_beat.valid {
        failed <- failed | (axi.ar.transfer & ~legal) |
                  (backend_beat.valid & ~has_backend_slot) |
                  (fill_backend &
                   (backend_beat.payload.last != selected_backend_last))
    }
}

struct Axi4BackendWriteRequest<AW=32,WIW=4,SW=2> {
    slot : bits<SW>
    address : Axi4Address<AW,WIW>
}

struct Axi4BackendWriteBeat<DW=32,SW=2> {
    slot : bits<SW>
    data : bits<DW>
    strb : bits<DW/8>
    last : bit
}

struct Axi4BackendWriteResult<SW=2> {
    slot : bits<SW>
    resp : bits<2>
}

module AXI4WriteSubordinate<AW=32,DW=32,WIW=4,D=4,SW=2,EXCLUSIVE=0>
where AW >= 1 && AW <= 64 && WIW >= 1 && WIW <= 32 &&
      DW >= 8 && DW <= 1024 && is_power_of_two(DW) &&
      D >= 2 && is_power_of_two(D) && SW == floor_log2(D) &&
      EXCLUSIVE >= 0 && EXCLUSIVE <= 1 {
    clock clk reset rst
    interface axi : AXI4Write<AW,DW,WIW>.slave @clk
    out backend_request : rv<Axi4BackendWriteRequest<AW,WIW,SW>>
    out backend_beat : rv<Axi4BackendWriteBeat<DW,SW>>
    in backend_result : rv<Axi4BackendWriteResult<SW>>
    out result_can_accept : bit
    out response_slot : bits<SW>
    out protocol_error : bit

    reg occupied : vec<D,bit> = generate(i in 0..D) 0
    reg invalid : vec<D,bit> = generate(i in 0..D) 0
    reg completed : vec<D,bit> = generate(i in 0..D) 0
    reg requests : vec<D,Axi4Address<AW,WIW>> = generate(i in 0..D)
        Axi4Address { id=0 addr=0 len=0 size=0 burst=1 lock=0
                      cache=0 prot=0 qos=0 region=0 }
    reg remaining : vec<D,u9> = generate(i in 0..D) 0
    reg beat_index : vec<D,u9> = generate(i in 0..D) 0
    // AW order controls the W channel irrespective of ID.  Response order
    // is separately tracked per ID; neither relation uses a wrapping count.
    reg older_data : vec<D,vec<D,bit>> = generate(i in 0..D)
        generate(j in 0..D) 0
    reg older_id : vec<D,vec<D,bit>> = generate(i in 0..D)
        generate(j in 0..D) 0
    reg output_valid : bit = 0
    reg output_slot : bits<SW> = 0
    reg output_payload : Axi4WriteResponse<WIW> =
        Axi4WriteResponse { id=0 resp=0 }
    reg failed : bit = 0

    free = generate(i in 0..D)
        (~occupied[i] & ~reduce(|, generate(j in 0..D)
            ((j < i) & ~occupied[j])))
    has_free = reduce(|, free)
    free_slot = reduce(|, generate(i in 0..D)
        mux(free[i], bitcast<bits<SW>>(truncate<SW>(i)), zeros<SW>))
    legal = axi4_address_valid<AW=AW,DW=DW,IW=WIW>(axi.aw.payload) &
        (~axi.aw.payload.lock |
         axi4_exclusive_address_valid<AW=AW,DW=DW,IW=WIW>(axi.aw.payload))
    backend_request.valid = axi.aw.valid & has_free & legal
    backend_request.payload = Axi4BackendWriteRequest {
        slot=free_slot address=axi.aw.payload
    }
    axi.aw.ready = has_free & (~legal | backend_request.ready)

    pending = generate(i in 0..D)
        (occupied[i] & (remaining[i] != 0) &
         ~reduce(|, generate(j in 0..D)
             (older_data[i][j] & occupied[j] & (remaining[j] != 0))))
    has_pending = reduce(|, pending)
    selected_slot = reduce(|, generate(i in 0..D)
        mux(pending[i], bitcast<bits<SW>>(truncate<SW>(i)), zeros<SW>))
    selected_request_bits = reduce(|, generate(i in 0..D)
        mux(pending[i], bitcast<bits<AW+WIW+29>>(requests[i]),
            zeros<AW+WIW+29>))
    selected_request = bitcast<Axi4Address<AW,WIW>>(
        selected_request_bits)
    selected_index = reduce(|, generate(i in 0..D)
        mux(pending[i], beat_index[i], extend<9>(0)))
    selected_invalid = reduce(|, generate(i in 0..D)
        (pending[i] & invalid[i]))
    selected_last = reduce(|, generate(i in 0..D)
        (pending[i] & (remaining[i] == 1)))
    axi.w.ready = has_pending & (selected_invalid | backend_beat.ready)
    backend_beat.valid = axi.w.valid & has_pending & ~selected_invalid
    backend_beat.payload = Axi4BackendWriteBeat {
        slot=selected_slot data=axi.w.payload.data
        strb=axi.w.payload.strb last=selected_last
    }
    finished_data = generate(i in 0..D)
        (axi.w.transfer & pending[i] & selected_last)

    response_eligible = generate(i in 0..D)
        (occupied[i] & completed[i] &
         ~(output_valid &
           (output_slot == bitcast<bits<SW>>(truncate<SW>(i)))) &
         ~reduce(|, generate(j in 0..D)
             (older_id[i][j] & occupied[j])))
    invalid_candidate = generate(i in 0..D)
        (response_eligible[i] & invalid[i])
    invalid_selected = generate(i in 0..D)
        (invalid_candidate[i] & ~reduce(|, generate(j in 0..D)
            ((j < i) & invalid_candidate[j])))
    has_invalid = reduce(|, invalid_selected)
    selected_invalid_slot = reduce(|, generate(i in 0..D)
        mux(invalid_selected[i],
            bitcast<bits<SW>>(truncate<SW>(i)), zeros<SW>))
    selected_invalid_id = reduce(|, generate(i in 0..D)
        mux(invalid_selected[i], requests[i].id, zeros<WIW>))
    backend_selected = generate(i in 0..D)
        (response_eligible[i] & ~invalid[i] &
         (backend_result.payload.slot ==
          bitcast<bits<SW>>(truncate<SW>(i))))
    has_backend_slot = reduce(|, backend_selected)
    selected_backend_id = reduce(|, generate(i in 0..D)
        mux(backend_selected[i], requests[i].id, zeros<WIW>))
    selected_backend_exclusive = reduce(|, generate(i in 0..D)
        (backend_selected[i] & requests[i].lock))
    can_fill = ~output_valid | axi.b.ready
    fill_invalid = can_fill & has_invalid
    fill_backend = can_fill & ~has_invalid &
                   backend_result.valid & has_backend_slot
    fill = fill_invalid | fill_backend
    can_accept_result = can_fill & ~has_invalid & has_backend_slot
    result_can_accept = can_accept_result
    backend_result.ready = can_accept_result

    axi.b.valid = output_valid
    axi.b.payload = output_payload
    response_slot = output_slot
    protocol_error = failed
    retiring = generate(i in 0..D)
        (axi.b.transfer &
         (output_slot == bitcast<bits<SW>>(truncate<SW>(i))))

    occupied <- generate(i in 0..D)
        mux(axi.aw.transfer & free[i], 1,
            mux(retiring[i], 0, occupied[i]))
    invalid <- generate(i in 0..D)
        mux(axi.aw.transfer & free[i], ~legal,
            mux(retiring[i], 0, invalid[i]))
    completed <- generate(i in 0..D)
        mux(axi.aw.transfer & free[i], 0,
            mux(retiring[i], 0, completed[i] | finished_data[i]))
    requests <- generate(i in 0..D)
        mux(axi.aw.transfer & free[i], axi.aw.payload, requests[i])
    remaining <- generate(i in 0..D)
        mux(axi.aw.transfer & free[i],
            truncate<9>(extend<9>(axi.aw.payload.len) + 1),
            mux(axi.w.transfer & pending[i],
                truncate<9>(remaining[i] - 1), remaining[i]))
    beat_index <- generate(i in 0..D)
        mux(axi.aw.transfer & free[i], 0,
            mux(axi.w.transfer & pending[i],
                truncate<9>(beat_index[i] + 1), beat_index[i]))
    older_data <- generate(i in 0..D)
        generate(j in 0..D)
            mux(axi.aw.transfer & free[i],
                occupied[j] & (remaining[j] != 0) & ~finished_data[j],
                older_data[i][j] & ~finished_data[j])
    older_id <- generate(i in 0..D)
        generate(j in 0..D)
            mux(axi.aw.transfer & free[i],
                occupied[j] & (requests[j].id == axi.aw.payload.id) &
                    ~retiring[j],
                older_id[i][j] & ~retiring[j])
    output_valid <- mux(fill, 1,
                        mux(axi.b.transfer, 0, output_valid))
    output_slot <- mux(fill_invalid, selected_invalid_slot,
                       mux(fill_backend, backend_result.payload.slot,
                           output_slot))
    output_payload <- mux(fill_invalid,
        Axi4WriteResponse { id=selected_invalid_id resp=3 },
        mux(fill_backend,
            Axi4WriteResponse {
                id=selected_backend_id
                // A non-exclusive-capable subordinate never claims EXOKAY.
                resp=mux((backend_result.payload.resp == 1) &
                         ~((EXCLUSIVE == 1) & selected_backend_exclusive),
                         zeros<2>, backend_result.payload.resp)
            }, output_payload))
    when axi.aw.transfer | axi.w.transfer | backend_result.valid {
        failed <- failed | (axi.aw.transfer & ~legal) |
                  (backend_result.valid & ~has_backend_slot) |
                  (axi.w.transfer &
                   ((axi.w.payload.last != selected_last) |
                    ~axi4_write_strobe_valid<AW=AW,DW=DW>(
                        axi4_beat_address<AW=AW,IW=WIW>(
                            selected_request, selected_index),
                        selected_request.size, axi.w.payload.strb)))
    }
}

// The physical five-channel endpoint composes two independent bounded
// transaction engines.  The connections below exercise the same generic
// static-child signal projection available to every protocol family.
module AXI4Subordinate<AW=32,DW=32,RIW=4,WIW=4,D=4,SW=2,EXCLUSIVE=0>
where AW >= 1 && AW <= 64 && RIW >= 1 && RIW <= 32 &&
      WIW >= 1 && WIW <= 32 && DW >= 8 && DW <= 1024 &&
      is_power_of_two(DW) && D >= 2 && is_power_of_two(D) &&
      SW == floor_log2(D) && EXCLUSIVE >= 0 && EXCLUSIVE <= 1 {
    clock clk reset rst
    interface axi : AXI4<AW,DW,RIW,WIW>.slave @clk
    out backend_read_request : rv<Axi4BackendReadRequest<AW,RIW,SW>>
    in backend_read_beat : rv<Axi4BackendReadBeat<DW,SW>>
    out backend_write_request : rv<Axi4BackendWriteRequest<AW,WIW,SW>>
    out backend_write_beat : rv<Axi4BackendWriteBeat<DW,SW>>
    in backend_write_result : rv<Axi4BackendWriteResult<SW>>
    out backend_write_result_can_accept : bit = writer.result_can_accept
    out backend_write_response_slot : bits<SW> = writer.response_slot
    out protocol_error : bit = reader.protocol_error | writer.protocol_error

    reader : AXI4ReadSubordinate<AW,DW,RIW,D,SW,EXCLUSIVE>
    writer : AXI4WriteSubordinate<AW,DW,WIW,D,SW,EXCLUSIVE>

    reader.axi.ar.payload = axi.ar.payload
    reader.axi.ar.valid = axi.ar.valid
    axi.ar.ready = reader.axi.ar.ready
    axi.r.payload = reader.axi.r.payload
    axi.r.valid = reader.axi.r.valid
    reader.axi.r.ready = axi.r.ready

    writer.axi.aw.payload = axi.aw.payload
    writer.axi.aw.valid = axi.aw.valid
    axi.aw.ready = writer.axi.aw.ready
    writer.axi.w.payload = axi.w.payload
    writer.axi.w.valid = axi.w.valid
    axi.w.ready = writer.axi.w.ready
    axi.b.payload = writer.axi.b.payload
    axi.b.valid = writer.axi.b.valid
    writer.axi.b.ready = axi.b.ready

    reader.backend_request -> backend_read_request
    backend_read_beat -> reader.backend_beat
    writer.backend_request -> backend_write_request
    writer.backend_beat -> backend_write_beat
    backend_write_result -> writer.backend_result
}
