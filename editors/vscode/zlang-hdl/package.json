{
  "name": "zlang-hdl",
  "displayName": "ZLang HDL",
  "description": "ZLang HDL .zhl editing support with the Community zlang-lsp client.",
  "version": "0.1.0",
  "publisher": "postoroniy",
  "author": "Viacheslav Vinogradov",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/postoroniy/zlang-hdl.git",
    "directory": "editors/vscode/zlang-hdl"
  },
  "bugs": {
    "url": "https://github.com/postoroniy/zlang-hdl/issues"
  },
  "homepage": "https://github.com/postoroniy/zlang-hdl",
  "engines": {
    "vscode": "^1.141.0"
  },
  "main": "./extension.js",
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "zlang",
    "zlang-hdl",
    "hdl",
    "fpga",
    "asic",
    "systemverilog",
    "rtl"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension starts the configured local zlang-lsp executable only in a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "files": [
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "extension.js",
    "language-configuration.json",
    "recommended-settings.json",
    "syntaxes/zlang.tmLanguage.json",
    "snippets/zlang-hdl.json"
  ],
  "scripts": {
    "static": "node test/javascript-static.cjs",
    "test": "npm run static && node test/javascript-static.test.cjs && node test/host-log.test.cjs && node test/project-metadata.test.cjs && node test/tokenize.test.cjs && node test/wcp.test.cjs && node test/waveform-model.test.cjs && node test/waveform-client.test.cjs && node test/waveform-clipboard.test.cjs && node test/debug-waveform.test.cjs && node test/waveform-live-ui.test.cjs && node test/bundle.test.cjs",
    "test:waveform": "node test/waveform-browser.cjs",
    "prepackage": "npm run static",
    "package": "node test/package.cjs",
    "prepackage:linux-x64": "npm run static",
    "package:linux-x64": "node test/package.cjs --target linux-x64",
    "test:host": "node test/run-host-smoke.cjs",
    "check:latest-vscode": "node test/check-latest-vscode.cjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "zlang-hdl",
        "aliases": [
          "ZLang HDL",
          "ZLang"
        ],
        "extensions": [
          ".zhl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "zlang-hdl",
        "path": "./snippets/zlang-hdl.json"
      }
    ],
    "grammars": [
      {
        "language": "zlang-hdl",
        "scopeName": "source.zlang",
        "path": "./syntaxes/zlang.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zlang-hdl.cutWaveformRows",
        "title": "ZLang HDL: Cut Waveform Rows",
        "enablement": "activeCustomEditorId == zlang-hdl.waveform || activeWebviewPanelId == zlang-hdl.liveWaveform"
      },
      {
        "command": "zlang-hdl.copyWaveformRows",
        "title": "ZLang HDL: Copy Waveform Rows",
        "enablement": "activeCustomEditorId == zlang-hdl.waveform || activeWebviewPanelId == zlang-hdl.liveWaveform"
      },
      {
        "command": "zlang-hdl.pasteWaveformRows",
        "title": "ZLang HDL: Paste Waveform Rows",
        "enablement": "activeCustomEditorId == zlang-hdl.waveform || activeWebviewPanelId == zlang-hdl.liveWaveform"
      },
      {
        "command": "zlang-hdl.startSimulation",
        "title": "ZLang HDL: Start Native Simulation Debugger"
      },
      {
        "command": "zlang-hdl.openWaveform",
        "title": "ZLang HDL: Open Waveform"
      },
      {
        "command": "zlang-hdl.openLiveWaveform",
        "title": "ZLang HDL: Open Live Waveform"
      },
      {
        "command": "zlang-hdl.addToWaveform",
        "title": "Add to Waveform"
      },
      {
        "command": "zlang-hdl.addTraceSignals",
        "title": "ZLang HDL: Add Live Trace Signals"
      },
      {
        "command": "zlang-hdl.saveWaveformSession",
        "title": "ZLang HDL: Save Waveform Session"
      },
      {
        "command": "zlang-hdl.loadWaveformSession",
        "title": "ZLang HDL: Load Waveform Session"
      }
    ],
    "keybindings": [
      {
        "command": "zlang-hdl.cutWaveformRows", "key": "ctrl+x", "mac": "cmd+x",
        "when": "webviewFocus && (activeCustomEditorId == zlang-hdl.waveform || activeWebviewPanelId == zlang-hdl.liveWaveform)"
      },
      {
        "command": "zlang-hdl.copyWaveformRows", "key": "ctrl+c", "mac": "cmd+c",
        "when": "webviewFocus && (activeCustomEditorId == zlang-hdl.waveform || activeWebviewPanelId == zlang-hdl.liveWaveform)"
      },
      {
        "command": "zlang-hdl.pasteWaveformRows", "key": "ctrl+v", "mac": "cmd+v",
        "when": "webviewFocus && (activeCustomEditorId == zlang-hdl.waveform || activeWebviewPanelId == zlang-hdl.liveWaveform)"
      }
    ],
    "breakpoints": [
      {"language": "zlang-hdl"}
    ],
    "debuggers": [
      {
        "type": "zlang-hdl",
        "label": "ZLang HDL Native Simulation",
        "languages": [
          "zlang-hdl"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program",
              "top"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Saved root .zhl source"
              },
              "top": {
                "type": "string",
                "description": "Top module"
              },
              "project": {
                "type": "string",
                "description": "Optional zlang.toml path"
              },
              "profile": {
                "type": "string",
                "description": "Optional implementation profile"
              },
              "events": {
                "type": "string",
                "description": "Bounded JSONL stimulus"
              },
              "clock": {
                "type": "string",
                "description": "Clock used with cycles"
              },
              "cycles": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "logicState": {
                "type": "boolean",
                "default": true
              },
              "strictUninitialized": {
                "type": "boolean",
                "default": false
              },
              "initialRegisters": {
                "type": "object",
                "default": {}
              },
              "traceSignals": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "zlang-hdl",
            "request": "launch",
            "name": "Debug ZLang HDL",
            "program": "${file}",
            "top": "Top",
            "project": "${workspaceFolder}/zlang.toml",
            "profile": "portable",
            "logicState": true,
            "strictUninitialized": false,
            "initialRegisters": {},
            "traceSignals": [],
            "stopOnEntry": true
          }
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "zlang-hdl.waveform",
        "displayName": "ZLang HDL Waveform",
        "selector": [
          {
            "filenamePattern": "*.vcd"
          },
          {
            "filenamePattern": "*.fst"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "debug/variables/context": [
        {"command":"zlang-hdl.addToWaveform", "when":"debugType == zlang-hdl", "group":"zlang@1"}
      ],
      "debug/watch/context": [
        {"command":"zlang-hdl.addToWaveform", "when":"debugType == zlang-hdl", "group":"zlang@1"}
      ],
      "editor/title": [
        {
          "command": "zlang-hdl.startSimulation",
          "when": "resourceLangId == zlang-hdl",
          "group": "navigation"
        },
        {
          "command": "zlang-hdl.saveWaveformSession",
          "when": "activeCustomEditorId == zlang-hdl.waveform",
          "group": "navigation"
        },
        {
          "command": "zlang-hdl.loadWaveformSession",
          "when": "activeCustomEditorId == zlang-hdl.waveform",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ZLang HDL",
      "properties": {
        "zlang.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Direct path or PATH command for the Community zlang-lsp executable. Use ${workspaceFolder}/.venv/bin/zlang-lsp for a repository checkout."
        },
        "zlang.waveform.wcp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the loopback-only Waveform Control Protocol listener in trusted workspaces. WCP v0 remains compatible; v1 adds sessions, selections, cursors, bookmarks and measurements."
        },
        "zlang.waveform.wcp.port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "Loopback WCP port. Zero selects an ephemeral port."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  }
}
