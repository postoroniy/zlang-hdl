{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZLang HDL",
  "scopeName": "source.zlang",
  "patterns": [
    {"include": "#strings"},
    {"include": "#comments"},
    {"include": "#equiv-blocks"},
    {"include": "#verification-declarations"},
    {"include": "#bit-slices"},
    {"include": "#numbers"},
    {"include": "#enum-declarations"},
    {"include": "#union-declarations"},
    {"include": "#union-match-arms"},
    {"include": "#resource-declarations"},
    {"include": "#generic-parameters"},
    {"include": "#declarations"},
    {"include": "#labels"},
    {"include": "#csr-layout"},
    {"include": "#declaration-details"},
    {"include": "#generic-calls"},
    {"include": "#intrinsics"},
    {"include": "#packed-constants"},
    {"include": "#pattern-constants"},
    {"include": "#types"},
    {"include": "#range-binders"},
    {"include": "#keywords"},
    {"include": "#modes"},
    {"include": "#enum-members"},
    {"include": "#members"},
    {"include": "#calls"},
    {"include": "#operators"},
    {"include": "#identifiers"}
  ],
  "repository": {
    "strings": {
      "patterns": [
        {
          "name": "invalid.illegal.empty-string.zlang",
          "match": "\"\""
        },
        {
          "name": "string.quoted.double.zlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {"name": "constant.character.escape.zlang", "match": "\\\\(?:0|n|r|t|\\\\|'|\"|x[0-9A-Fa-f]{2})"},
            {"name": "invalid.illegal.escape.zlang", "match": "\\\\."},
            {"name": "invalid.illegal.raw-character.zlang", "match": "[^\\x20-\\x7e]"}
          ]
        },
        {
          "name": "constant.character.zlang",
          "match": "'(?:(?!['\\\\])[\\x20-\\x7e]|\\\\(?:0|n|r|t|\\\\|'|\"|x[0-9A-Fa-f]{2}))'"
        },
        {
          "name": "invalid.illegal.character.zlang",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {"name": "constant.character.escape.zlang", "match": "\\\\(?:0|n|r|t|\\\\|'|\"|x[0-9A-Fa-f]{2})"},
            {"name": "invalid.illegal.escape.zlang", "match": "\\\\."},
            {"name": "invalid.illegal.raw-character.zlang", "match": "[^\\x20-\\x7e]"}
          ]
        }
      ]
    },
    "equiv-blocks": {
      "patterns": [
        {
          "name": "meta.equiv.declaration.zlang",
          "begin": "\\b(equiv)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
          "beginCaptures": {"1": {"name": "storage.type.zlang"}, "2": {"name": "entity.name.function.rule.zlang"}, "3": {"name": "punctuation.section.block.begin.zlang"}},
          "end": "(\\})",
          "endCaptures": {"1": {"name": "punctuation.section.block.end.zlang"}},
          "patterns": [
            {"include": "#pattern-constants"},
            {"include": "$self"}
          ]
        }
      ]
    },
    "verification-declarations": {
      "patterns": [
        {
          "name": "meta.verification.scope.declaration.zlang",
          "match": "\\b(contract)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(@)\\s*([A-Za-z_][A-Za-z0-9_]*))?\\s*(?=\\{)",
          "captures": {
            "1": {"name": "keyword.control.verification.zlang"},
            "2": {"name": "entity.name.type.verification-scope.zlang"},
            "3": {"name": "keyword.operator.annotation.zlang"},
            "4": {"name": "variable.other.readwrite.zlang"}
          }
        },
        {
          "name": "meta.verification.goal.declaration.zlang",
          "match": "\\b(assert|cover)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(@)\\s*([A-Za-z_][A-Za-z0-9_]*))?\\s*(?=\\{)",
          "captures": {
            "1": {"name": "keyword.control.verification.zlang"},
            "2": {"name": "entity.name.function.property.zlang"},
            "3": {"name": "keyword.operator.annotation.zlang"},
            "4": {"name": "variable.other.readwrite.zlang"}
          }
        },
        {
          "name": "meta.verification.clause.declaration.zlang",
          "match": "\\b(require|assert|ensure|cover)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\{)",
          "captures": {
            "1": {"name": "keyword.control.verification.zlang"},
            "2": {"name": "entity.name.function.property.zlang"}
          }
        },
        {
          "name": "keyword.control.exploration.zlang",
          "match": "\\brequire(?=\\s*\\{)"
        }
      ]
    },
    "comments": {
      "patterns": [
        {"name": "comment.line.double-slash.zlang", "match": "//.*$"},
        {"name": "comment.block.zlang", "begin": "/\\*", "end": "\\*/"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.exact-decimal.zlang", "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*\\b"},
        {"name": "constant.numeric.binary.zlang", "match": "\\b0[bB][01](?:_?[01])*\\b"},
        {"name": "constant.numeric.hex.zlang", "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*\\b"},
        {"name": "constant.numeric.decimal.zlang", "match": "\\b[0-9](?:_?[0-9])*\\b"}
      ]
    },
    "bit-slices": {
      "patterns": [
        {
          "name": "meta.bit-slice.zlang",
          "begin": "(\\[)(?=[^]\\n]+:[^]\\n]+\\])",
          "beginCaptures": {"1": {"name": "punctuation.section.brackets.begin.zlang"}},
          "end": "(\\])",
          "endCaptures": {"1": {"name": "punctuation.section.brackets.end.zlang"}},
          "patterns": [
            {"include": "#numbers"},
            {"name": "punctuation.separator.slice.zlang", "match": ":"},
            {"name": "keyword.operator.arithmetic.zlang", "match": "\\+|-|\\*|/"},
            {"name": "variable.other.constant.parameter.zlang", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"}
          ]
        }
      ]
    },
    "enum-declarations": {
      "patterns": [
        {
          "name": "meta.enum.declaration.zlang",
          "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
          "beginCaptures": {"1": {"name": "storage.type.enum.zlang"}, "2": {"name": "entity.name.type.enum.zlang"}, "3": {"name": "punctuation.section.block.begin.zlang"}},
          "end": "(\\})",
          "endCaptures": {"1": {"name": "punctuation.section.block.end.zlang"}},
          "patterns": [
            {"include": "#comments"},
            {"name": "constant.other.enum.member.zlang", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"}
          ]
        }
      ]
    },
    "union-declarations": {
      "patterns": [
        {
          "name": "meta.union.declaration.zlang",
          "begin": "\\b(union)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
          "beginCaptures": {"1": {"name": "storage.type.union.zlang"}, "2": {"name": "entity.name.type.union.zlang"}, "3": {"name": "punctuation.section.block.begin.zlang"}},
          "end": "(\\})",
          "endCaptures": {"1": {"name": "punctuation.section.block.end.zlang"}},
          "patterns": [
            {"include": "#comments"},
            {
              "name": "meta.union.variant.fields.zlang",
              "begin": "^\\s*([A-Z][A-Za-z0-9_]*)\\s*(\\{)",
              "beginCaptures": {"1": {"name": "constant.other.union.variant.zlang"}, "2": {"name": "punctuation.section.block.begin.zlang"}},
              "end": "(\\})",
              "endCaptures": {"1": {"name": "punctuation.section.block.end.zlang"}},
              "patterns": [
                {"include": "#comments"},
                {"match": "\\b([a-z_][A-Za-z0-9_]*)(\\s*)(:)", "captures": {"1": {"name": "variable.other.definition.union-field.zlang"}, "3": {"name": "punctuation.separator.type.zlang"}}},
                {"include": "#types"}
              ]
            },
            {"name": "constant.other.union.variant.zlang", "match": "^\\s*[A-Z][A-Za-z0-9_]*\\s*$"}
          ]
        }
      ]
    },
    "union-match-arms": {
      "patterns": [
        {"match": "\\b([A-Z][A-Za-z0-9_]*)(\\.)([A-Z][A-Za-z0-9_]*)(?=\\s*(?:\\{|=>))", "captures": {"1": {"name": "entity.name.type.union.zlang"}, "2": {"name": "punctuation.accessor.zlang"}, "3": {"name": "constant.other.union.variant.zlang"}}},
        {"match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*[,}]\\s*=>)", "captures": {"1": {"name": "variable.parameter.pattern.union.zlang"}}}
      ]
    },
    "declarations": {
      "patterns": [
        {"match": "^\\s*(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<|\\{))", "captures": {"1": {"name": "storage.type.interface.zlang"}, "2": {"name": "entity.name.type.interface.zlang"}}},
        {"match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "storage.type.module.zlang"}, "2": {"name": "entity.name.type.module.zlang"}}},
        {"match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "storage.type.function.zlang"}, "2": {"name": "entity.name.function.zlang"}}},
        {"match": "\\b(enum|struct|type|protocol|union|target|device|architecture)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "storage.type.zlang"}, "2": {"name": "entity.name.type.zlang"}}},
        {"match": "\\b(operator)\\s+([+*\\-])", "captures": {"1": {"name": "storage.type.function.operator.zlang"}, "2": {"name": "keyword.operator.overload.zlang"}}},
        {"match": "\\b(equiv)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "storage.type.zlang"}, "2": {"name": "entity.name.function.rule.zlang"}}},
        {"match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "storage.type.zlang"}, "2": {"name": "entity.name.type.parameter.zlang"}}}
      ]
    },
    "declaration-details": {
      "patterns": [
        {
          "begin": "^\\s*(in|out)\\b",
          "beginCaptures": {"1": {"name": "storage.modifier.direction.zlang"}},
          "end": "(:)",
          "endCaptures": {"1": {"name": "punctuation.separator.type.zlang"}},
          "patterns": [
            {"name": "variable.parameter.port.zlang", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"},
            {"name": "punctuation.separator.sequence.zlang", "match": ","}
          ]
        },
        {"match": "\\b(clock|reset|reg|fifo|memory|rom|interface|csr)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "storage.modifier.hardware.zlang"}, "2": {"name": "variable.other.definition.hardware.zlang"}}},
        {"match": "\\b(rule)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "storage.modifier.rule.zlang"}, "2": {"name": "entity.name.label.rule.zlang"}}},
        {"match": "\\b(assume|guarantee)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "keyword.control.verification.zlang"}, "2": {"name": "entity.name.function.property.zlang"}}},
        {"match": "\\b(role|channel|member)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "keyword.declaration.protocol.zlang"}, "2": {"name": "entity.name.type.protocol.zlang"}}},
        {"match": "\\b(class|operation|capability|limit|provides|require_resource|use_pipeline|require_dedicated|part|inventory|dedicated_capacity)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "keyword.other.directive.target.zlang"}, "2": {"name": "entity.name.constant.target.zlang"}}},
        {"match": "\\b(port|register_site|pipeline_site|pipeline_config|dedicated|binding|physical_primitive|physical_site|physical_edge)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "keyword.other.directive.target.zlang"}, "2": {"name": "entity.name.tag.target.zlang"}}},
        {"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?=\\s*(?:bit|[us][1-9][0-9]*|uint\\s*<|sint\\s*<|bits\\s*<|fixed(?:_sat)?\\s*<|ufixed(?:_sat)?\\s*<|vec\\s*<|fifo\\s*<|mem\\s*<|rom\\s*<|wire\\s*<|rv\\s*<|credit\\s*<|packet\\s*<|vc_credit\\s*<|request_response\\s*<|(?:SF|UF)(?:_Sat)?[1-9]|[A-Z][A-Za-z0-9_]*))", "captures": {"1": {"name": "variable.other.definition.zlang"}, "2": {"name": "punctuation.separator.type.zlang"}}}
      ]
    },
    "resource-declarations": {
      "patterns": [
        {
          "name": "meta.resource.declaration.zlang",
          "begin": "\\b(resource)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
          "beginCaptures": {"1": {"name": "storage.type.zlang"}, "2": {"name": "entity.name.type.zlang"}, "3": {"name": "punctuation.section.block.begin.zlang"}},
          "end": "(\\})",
          "endCaptures": {"1": {"name": "punctuation.section.block.end.zlang"}},
          "patterns": [
            {"include": "#comments"},
            {"include": "#numbers"},
            {"include": "#resource-body"},
            {"include": "#types"},
            {"include": "#modes"},
            {"include": "#operators"}
          ]
        }
      ]
    },
    "resource-body": {
      "patterns": [
        {"match": "\\b(port|operation|class|capability|limit|register_site|pipeline_site|pipeline_config|dedicated|binding|physical_primitive|physical_site|physical_edge)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "keyword.other.directive.target.zlang"}, "2": {"name": "entity.name.tag.target.zlang"}}},
        {"name": "keyword.other.directive.target.zlang", "match": "\\b(?:location|local|delay_ps|enable|setting|width|relation|fallback)\\b"},
        {"name": "constant.language.direction.zlang", "match": "\\b(?:input|output|signed|unsigned)\\b"}
      ]
    },
    "csr-layout": {
      "patterns": [
        {"match": "^\\s*([A-Z][A-Za-z0-9_]*)\\s*(?=@)", "captures": {"1": {"name": "entity.name.section.csr.zlang"}}},
        {"match": "^\\s*([a-z_][A-Za-z0-9_]*)\\s*(?=(?:bit|[us][1-9][0-9]*|uint\\s*<|sint\\s*<|bits\\s*<|fixed(?:_sat)?\\s*<|ufixed(?:_sat)?\\s*<|(?:SF|UF)(?:_Sat)?[1-9]|[A-Z][A-Za-z0-9_]*)\\s+@)", "captures": {"1": {"name": "variable.other.definition.csr.zlang"}}}
      ]
    },
    "generic-parameters": {
      "patterns": [
        {
          "name": "meta.declaration.parameters.zlang",
          "begin": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<)",
          "beginCaptures": {"1": {"name": "storage.type.module.zlang"}, "2": {"name": "entity.name.type.module.zlang"}, "3": {"name": "punctuation.definition.parameters.begin.zlang"}},
          "end": "(>)(?=\\s*(?:\\(|\\{))",
          "endCaptures": {"1": {"name": "punctuation.definition.parameters.end.zlang"}},
          "patterns": [{"include": "#generic-parameter-body"}]
        },
        {
          "name": "meta.declaration.parameters.zlang",
          "begin": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<)",
          "beginCaptures": {"1": {"name": "storage.type.function.zlang"}, "2": {"name": "entity.name.function.zlang"}, "3": {"name": "punctuation.definition.parameters.begin.zlang"}},
          "end": "(>)(?=\\s*\\()",
          "endCaptures": {"1": {"name": "punctuation.definition.parameters.end.zlang"}},
          "patterns": [{"include": "#generic-parameter-body"}]
        },
        {
          "name": "meta.declaration.parameters.zlang",
          "begin": "\\b(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<)",
          "beginCaptures": {"1": {"name": "storage.type.interface.zlang"}, "2": {"name": "entity.name.type.interface.zlang"}, "3": {"name": "punctuation.definition.parameters.begin.zlang"}},
          "end": "(>)(?=\\s*\\{)",
          "endCaptures": {"1": {"name": "punctuation.definition.parameters.end.zlang"}},
          "patterns": [{"include": "#generic-parameter-body"}]
        },
        {
          "name": "meta.declaration.parameters.zlang",
          "begin": "\\b(struct|protocol)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<)",
          "beginCaptures": {"1": {"name": "storage.type.zlang"}, "2": {"name": "entity.name.type.zlang"}, "3": {"name": "punctuation.definition.parameters.begin.zlang"}},
          "end": "(>)(?=\\s*\\{)",
          "endCaptures": {"1": {"name": "punctuation.definition.parameters.end.zlang"}},
          "patterns": [{"include": "#generic-parameter-body"}]
        },
        {
          "name": "meta.declaration.parameters.zlang",
          "begin": "\\b(operator)\\s+([+*\\-])\\s*(<)",
          "beginCaptures": {"1": {"name": "storage.type.function.operator.zlang"}, "2": {"name": "keyword.operator.overload.zlang"}, "3": {"name": "punctuation.definition.parameters.begin.zlang"}},
          "end": "(>)(?=\\s*\\()",
          "endCaptures": {"1": {"name": "punctuation.definition.parameters.end.zlang"}},
          "patterns": [{"include": "#generic-parameter-body"}]
        }
      ]
    },
    "generic-parameter-body": {
      "patterns": [
        {"include": "#comments"},
        {"include": "#numbers"},
        {"match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": {"1": {"name": "storage.type.zlang"}, "2": {"name": "entity.name.type.parameter.zlang"}}},
        {"name": "storage.type.function.zlang", "match": "\\bfn(?=\\s*\\()"},
        {"name": "punctuation.separator.type.zlang", "match": ":"},
        {"name": "punctuation.separator.sequence.zlang", "match": ","},
        {"name": "keyword.operator.assignment.zlang", "match": "="},
        {"include": "#operators"},
        {"name": "variable.other.constant.parameter.zlang", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"},
        {"include": "#types"}
      ]
    },
    "static-function-references": {
      "patterns": [
        {
          "match": "\\b(fn)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "storage.type.function.reference.zlang"},
            "3": {"name": "entity.name.function.reference.zlang"}
          }
        }
      ]
    },
    "generic-calls": {
      "patterns": [
        {
          "name": "meta.function-call.specialized.zlang",
          "begin": "\\b(repeat|delay|pipeline)(\\s*)(<)(?=[^<>\\n]*(?:<[^<>\\n]*>[^<>\\n]*)*>\\s*\\()",
          "beginCaptures": {"1": {"name": "support.function.builtin.hardware.zlang"}, "3": {"name": "punctuation.definition.type.begin.zlang"}},
          "end": "(>)(?=\\s*\\()",
          "endCaptures": {"1": {"name": "punctuation.definition.type.end.zlang"}},
          "patterns": [
            {"include": "#comments"},
            {"include": "#numbers"},
            {"include": "#types"},
            {"include": "#static-function-references"},
            {"name": "punctuation.separator.sequence.zlang", "match": ","},
            {"name": "keyword.operator.assignment.zlang", "match": "="},
            {"name": "variable.other.constant.parameter.zlang", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"}
          ]
        },
        {
          "name": "meta.function-call.specialized.zlang",
          "begin": "\\b(truncate|extend|quantize|unpack|bitcast|reshape)(\\s*)(<)(?=[^<>\\n]*(?:<[^<>\\n]*>[^<>\\n]*)*>\\s*\\()",
          "beginCaptures": {"1": {"name": "support.function.builtin.conversion.zlang"}, "3": {"name": "punctuation.definition.type.begin.zlang"}},
          "end": "(>)(?=\\s*\\()",
          "endCaptures": {"1": {"name": "punctuation.definition.type.end.zlang"}},
          "patterns": [
            {"include": "#comments"},
            {"include": "#numbers"},
            {"include": "#types"},
            {"include": "#static-function-references"},
            {"name": "punctuation.separator.sequence.zlang", "match": ","},
            {"name": "keyword.operator.assignment.zlang", "match": "="},
            {"name": "variable.other.constant.parameter.zlang", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"}
          ]
        },
        {
          "name": "meta.function-call.specialized.zlang",
          "begin": "\\b([a-z_][A-Za-z0-9_]*)(\\s*)(<)(?=[^<>\\n]*(?:<[^<>\\n]*>[^<>\\n]*)*>\\s*\\()",
          "beginCaptures": {"1": {"name": "entity.name.function.call.zlang"}, "3": {"name": "punctuation.definition.type.begin.zlang"}},
          "end": "(>)(?=\\s*\\()",
          "endCaptures": {"1": {"name": "punctuation.definition.type.end.zlang"}},
          "patterns": [
            {"include": "#comments"},
            {"include": "#numbers"},
            {"include": "#types"},
            {"include": "#static-function-references"},
            {"name": "punctuation.separator.sequence.zlang", "match": ","},
            {"name": "keyword.operator.assignment.zlang", "match": "="},
            {"name": "variable.other.constant.parameter.zlang", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"}
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {"name": "support.type.fixed-short.zlang", "match": "\\b(?:SF_Sat|UF_Sat|SF|UF)[1-9][0-9]*\\.[0-9]+\\b"},
        {
          "name": "meta.type.fixed.zlang",
          "begin": "\\b(fixed|ufixed|fixed_sat|ufixed_sat)(\\s*)(<)",
          "beginCaptures": {"1": {"name": "support.type.fixed.zlang"}, "3": {"name": "punctuation.definition.type.begin.zlang"}},
          "end": "(>)",
          "endCaptures": {"1": {"name": "punctuation.definition.type.end.zlang"}},
          "patterns": [
            {"include": "#numbers"},
            {"name": "punctuation.separator.sequence.zlang", "match": ","},
            {"name": "keyword.operator.arithmetic.zlang", "match": "<<|[+*\\-/]"},
            {"name": "variable.other.constant.parameter.zlang", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"}
          ]
        },
        {
          "name": "meta.type.scalar-generic.zlang",
          "begin": "\\b(uint|sint|bits)(\\s*)(<)",
          "beginCaptures": {"1": {"name": "support.type.scalar.zlang"}, "3": {"name": "punctuation.definition.type.begin.zlang"}},
          "end": "(>)",
          "endCaptures": {"1": {"name": "punctuation.definition.type.end.zlang"}},
          "patterns": [
            {"include": "#numbers"},
